def load_open_positions() -> list:
    if not OPEN_POS_FILE.is_file():
        return []
    try:
        data = json.loads(OPEN_POS_FILE.read_text(encoding="utf-8"))
        raw = data.get("positions") if isinstance(data, dict) else data
        out = []
        for r in raw or []:
            out.append(
                OpenPos(
                    slug=str(r.get("slug") or ""),
                    side=str(r.get("side") or "").upper(),
                    ask=float(r.get("ask") or 0),
                    cost_usd=float(r.get("cost_usd") or 0),
                    market_end=float(r.get("market_end") or 0),
                    open_price=float(r.get("open_price") or 0),
                    spot_at_entry=float(r.get("spot_at_entry") or 0),
                    ts=float(r.get("ts") or 0),
                    order_id=str(r.get("order_id") or ""),
                    live_filled=bool(r.get("live_filled", True)),
                    fill_px=float(r.get("fill_px") or 0),
                    decision_ask=float(r.get("decision_ask") or r.get("ask") or 0),
                    bad_fill=bool(r.get("bad_fill", False)),
                )
            )
        return out
    except Exception as e:
        log.warning(f"[DAXUE] load open positions failed: {e}")
        return []


def save_open_positions(positions: list) -> None:
    LOGS_DIR.mkdir(parents=True, exist_ok=True)
    payload = {
        "updated": time.time(),
        "strategy": "DAXUE",
        "open_count": len(positions),
        "open_cost": round(sum(p.cost_usd for p in positions), 4),
        "positions": [asdict(p) for p in positions],
    }
    OPEN_POS_FILE.write_text(json.dumps(payload, indent=2), encoding="utf-8")


class BinanceFeed:
    def __init__(self):
        self.prices: list = []
        self.latest = 0.0
        self._task = None

    async def start(self):
        self._task = asyncio.create_task(self._run())

    async def _run(self):
        url = "wss://data-stream.binance.vision/ws/btcusdt@trade"
        while True:
            try:
                async with websockets.connect(url, ping_interval=20) as ws:
                    log.info("[DAXUE] Binance WS connected")
                    async for raw in ws:
                        data = json.loads(raw)
                        price = float(data["p"])
                        now = time.time()
                        self.latest = price
                        self.prices.append(PricePoint(now, price))
                        self.prices = [p for p in self.prices if p.ts > now - 900]
            except Exception as e:
                log.error(f"[DAXUE] Binance error: {e}")
                await asyncio.sleep(2)


