def place_order_sync(
    slug: str,
    outcome: str,
    side: str,
    amount: float,
    price: Optional[float] = None,
    dry: bool = False,
    max_price: Optional[float] = None,
    decision_ask: Optional[float] = None,
) -> dict:
    """Call node place_order.mjs; never logs secrets.

    For BUY, pass max_price (hard cap) and decision_ask (logged). price is kept
    for SELL share derivation / backward compat; BUY prefers --max-price.
    """
    js = CONFIG.get("PLACE_ORDER_JS") or str(PLACE_ORDER_JS)
    amt = min(float(amount), float(CONFIG["POSITION_USD"]))
    if amt <= 0:
        return {"ok": False, "error": "amount_zero"}
    cmd = [
        "node",
        js,
        "--slug",
        str(slug),
        "--outcome",
        str(outcome).lower(),
        "--side",
        str(side).upper(),
        "--amount",
        f"{max(amt, 0.01):.2f}",
    ]
    if decision_ask is not None and decision_ask > 0:
        cmd.extend(["--decision-ask", f"{float(decision_ask):.4f}"])
    if max_price is not None and max_price > 0:
        cmd.extend(["--max-price", f"{float(max_price):.4f}"])
    elif price is not None and price > 0:
        # BUY without explicit max_price: --price becomes BUY cap in place_order.mjs
        cmd.extend(["--price", f"{float(price):.4f}"])
    if dry:
        cmd.append("--dry")
    env = os.environ.copy()
    env.setdefault("HTTPS_PROXY", "http://127.0.0.1:7897")
    env.setdefault("HTTP_PROXY", "http://127.0.0.1:7897")
    env.setdefault("ALL_PROXY", "http://127.0.0.1:7897")
    env.setdefault("NODE_OPTIONS", "--use-env-proxy")
    try:
        proc = subprocess.run(
            cmd,
            cwd=str(SCRIPT_DIR),
            env=env,
            capture_output=True,
            text=True,
            timeout=60,
        )
    except Exception as e:
        return {"ok": False, "error": f"subprocess: {e}"}
    raw = (proc.stdout or "").strip() or (proc.stderr or "").strip()
    parsed = None
    try:
        if raw:
            try:
                parsed = json.loads(raw)
            except Exception:
                i = raw.rfind("{")
                if i >= 0:
                    parsed = json.loads(raw[i:])
    except Exception:
        parsed = None
    ok = (
        proc.returncode == 0
        and isinstance(parsed, dict)
        and parsed.get("ok", True) is not False
    )
    if isinstance(parsed, dict):
        parsed = dict(parsed)
        parsed["ok"] = bool(ok)
        parsed["_returncode"] = proc.returncode
        return parsed
    return {
        "ok": False,
        "error": "bad_response",
        "_returncode": proc.returncode,
        "_stdout_tail": raw[-300:] if raw else "",
    }


async def place_order(
    slug: str,
    outcome: str,
    side: str,
    amount: float,
    price: Optional[float] = None,
    dry: bool = False,
    max_price: Optional[float] = None,
    decision_ask: Optional[float] = None,
) -> dict:
    return await asyncio.to_thread(
        place_order_sync,
        slug,
        outcome,
        side,
        amount,
        price,
        dry,
        max_price,
        decision_ask,
    )


def top_ask_size(book: dict) -> float:
    asks = book.get("asks") or []
    if not asks:
        return 0.0
    best = min(asks, key=lambda a: float(a.get("price") or 1))
    try:
        return float(best.get("size") or best.get("amount") or 0)
    except (TypeError, ValueError):
        return 0.0


def estimate_buy_fill(book: dict, cost_usd: float) -> Optional[float]:
    """Walk asks ascending; return VWAP fill estimate for spending cost_usd, or None."""
    asks = book.get("asks") or []
    if not asks or cost_usd <= 0:
        return None
    levels = []
    for a in asks:
        try:
            px = float(a.get("price"))
            sz = float(a.get("size") or a.get("amount") or 0)
        except (TypeError, ValueError):
            continue
        if px <= 0 or sz <= 0:
            continue
        levels.append((px, sz))
    if not levels:
        return None
    levels.sort(key=lambda x: x[0])
    remain = float(cost_usd)
    spent = 0.0
    shares = 0.0
    for px, sz in levels:
        level_notional = px * sz
        if level_notional <= remain + 1e-12:
            spent += level_notional
            shares += sz
            remain -= level_notional
        else:
            take = remain / px
            spent += remain
            shares += take
            remain = 0.0
            break
    if shares <= 0 or remain > 1e-6:
        # not enough depth — fall back to best ask if present
        return levels[0][0] if levels else None
    return spent / shares


def extract_fill_px(resp: dict) -> Optional[float]:
    if not isinstance(resp, dict):
        return None
    for k in ("fill_px", "fillPx", "avg_price", "averagePrice"):
        try:
            v = float(resp.get(k))
            if v > 0:
                return v
        except (TypeError, ValueError):
            pass
    r = resp.get("response")
    if isinstance(r, dict):
        try:
            taking = float(r.get("takingAmount") or r.get("taking_amount") or 0)
            making = float(r.get("makingAmount") or r.get("making_amount") or 0)
            if taking > 0 and making > 0:
                return making / taking  # BUY: collateral / shares
        except (TypeError, ValueError):
            pass
    return None


async def check_geoblock(session) -> dict:
    """Prefer curl via proxy — aiohttp can choke on polymarket.com CSP header size."""
    def _curl():
        try:
            proc = subprocess.run(
                [
                    "curl", "-sS", "-m", "10",
                    "-x", os.environ.get("HTTPS_PROXY", "http://127.0.0.1:7897"),
                    "https://polymarket.com/api/geoblock",
                ],
                capture_output=True,
                text=True,
                timeout=15,
            )
            raw = (proc.stdout or "").strip()
            if raw:
                return json.loads(raw)
            return {"error": f"curl_empty rc={proc.returncode} err={(proc.stderr or '')[:120]}"}
        except Exception as e:
            return {"error": str(e)}

    try:
        return await asyncio.to_thread(_curl)
    except Exception as e:
        return {"error": str(e)}


class DaxueBot:
    def __init__(self):
        self.bn = BinanceFeed()
        self.open_positions: list = load_open_positions()
        self.open_cache: dict = {}  # market_end -> btc open
        self._entered_slugs: set = set()
        self._start_ts = time.time()
        self._last_hb = 0.0
        self._last_settle_retry = 0.0
        self.day_risk = DayRiskState(LOGS_DIR, CONFIG)
        # restore entered slugs so restart won't double-enter same window
        for p in self.open_positions:
            if p.slug:
                self._entered_slugs.add(p.slug)

    def open_cost(self) -> float:
        return sum(p.cost_usd for p in self.open_positions)

    def prune_settled(self, now: float) -> None:
        """Free deploy budget after market_end (+grace). Hold-to-settlement: no sell.

        Also queue / Gamma-settle freed legs into DayRiskState (day_pnl / streak).
        """
        grace = 30.0
        kept = []
        freed = []
        for p in self.open_positions:
            if p.market_end > 0 and now >= p.market_end + grace:
                log.info(
                    f"[DAXUE][SETTLE] free slot {p.side} slug={p.slug} "
                    f"cost=${p.cost_usd:.2f} market_end={int(p.market_end)}"
                )
                freed.append(p)
            else:
                kept.append(p)
        if freed:
            self.open_positions = kept
            save_open_positions(self.open_positions)
            for p in freed:
                if not p.live_filled and CONFIG["DRY_RUN"]:
                    continue
                self.day_risk.queue_pending(p)
                self.day_risk.try_settle_one(
                    p.slug,
                    {
                        "side": p.side,
                        "cost_usd": p.cost_usd,
                        "fill_px": p.fill_px,
                        "decision_ask": p.decision_ask or p.ask,
                    },
                )
            self.day_risk.check_day_loss(self.open_positions)

    def pick_side(self, spot: float, open_price: float) -> Optional[str]:
        tol = float(CONFIG["OPEN_TOL_USD"])
        if open_price <= 0 or spot <= 0:
            return None
        delta = spot - open_price
        if abs(delta) < tol:
            return None
        return "UP" if delta > 0 else "DOWN"

    async def maybe_enter(self, session, market: Market, left: float, now: float) -> None:
        if not CONFIG["POLYMARKET_LIVE"] and not CONFIG["DRY_RUN"]:
            log.warning("[DAXUE][SKIP] POLYMARKET_LIVE!=1 and DAXUE_DRY_RUN!=1")
            return

        # Overnight pause Asia/Shanghai [start_h, end_h): no NEW entries
        if CONFIG.get("OVERNIGHT_PAUSE", True):
            sh_hour = datetime.now(TZ_SH).hour
            start_h = int(CONFIG["OVERNIGHT_PAUSE_START_H"])
            end_h = int(CONFIG["OVERNIGHT_PAUSE_END_H"])
            in_pause = (
                (start_h <= sh_hour < end_h)
                if start_h < end_h
                else (sh_hour >= start_h or sh_hour < end_h)
            )
            if in_pause:
                if int(now) % 30 < int(CONFIG["POLL_SEC"]) + 1:
                    log.info(
                        f"[DAXUE][SKIP] overnight-pause hour={sh_hour:02d} "
                        f"window={start_h:02d}-{end_h:02d} Asia/Shanghai "
                        f"left={left:.0f}s slug={market.slug}"
                    )
                return

        block = self.day_risk.entry_block_reason(self.open_positions, now)
        if block:
            if int(now) % 30 < int(CONFIG["POLL_SEC"]) + 1:
                log.info(
                    f"[DAXUE][SKIP] {block} day_pnl_settled="
                    f"${self.day_risk.day_pnl_settled:+.2f} "
                    f"for_stop=${self.day_risk.day_pnl_for_stop(self.open_positions):+.2f} "
                    f"streak_L={self.day_risk.consec_losses} "
                    f"left={left:.0f}s slug={market.slug}"
                )
            return

        # Post-window BUY banned
        if left <= 0 or now >= market.end_ts:
            log.info(
                f"[DAXUE][SKIP] post-window left={left:.0f}s now>={int(market.end_ts)}"
            )
            return

        if market.slug in self._entered_slugs:
            return  # at most ONE new entry per 5m window

        # already have a live position on this slug
        if any(p.slug == market.slug for p in self.open_positions):
            self._entered_slugs.add(market.slug)
            return

        spot = self.bn.latest
        open_px = market.open_price
        if spot <= 0 or open_px <= 0:
            return

        side = self.pick_side(spot, open_px)
        if side is None:
            # throttle noise skip logs via heartbeat mostly; occasional log
            if int(now) % 15 == 0:
                log.info(
                    f"[DAXUE][SKIP] no-edge |spot-open|={abs(spot-open_px):.2f}<"
                    f"{CONFIG['OPEN_TOL_USD']:.0f} spot={spot:.2f} open={open_px:.2f} "
                    f"left={left:.0f}s"
                )
            return

        cost = float(CONFIG["POSITION_USD"])
        max_deploy = float(CONFIG["MAX_DEPLOY_USD"])
        cur = self.open_cost()
        if cur + cost > max_deploy + 1e-9:
            log.info(
                f"[DAXUE][SKIP] max-deploy open_cost=${cur:.2f}+${cost:.2f}>"
                f"${max_deploy:.0f} side={side} left={left:.0f}s"
            )
            return

        token = market.token_up if side == "UP" else market.token_down
        book = await get_book(session, token)
        ask = best_ask(book)
        ask_min = float(CONFIG["ASK_MIN"])
        ask_max = float(CONFIG["ASK_MAX"])

        if ask > ask_max:
            log.info(
                f"[DAXUE][SKIP] chase-ban ask={ask:.3f}>{ask_max:.2f} side={side} "
                f"spot={spot:.2f} open={open_px:.2f} left={left:.0f}s slug={market.slug}"
            )
            return
        if ask < ask_min:
            log.info(
                f"[DAXUE][SKIP] ask-below-floor ask={ask:.3f}<{ask_min:.2f} side={side} "
                f"left={left:.0f}s"
            )
            return

        # Near ASK_MAX with thin top-of-book: skip (simple depth guard)
        slip = float(CONFIG["BUY_SLIP"])
        if ask >= ask_max - 0.02:
            depth = top_ask_size(book)
            need = cost / max(ask, 1e-6)
            if depth > 0 and depth < need * 1.25:
                log.info(
                    f"[DAXUE][SKIP] thin-near-cap ask={ask:.3f}~ask_max={ask_max:.2f} "
                    f"depth={depth:.2f}<need*{1.25:.2f}={need*1.25:.2f} side={side} "
                    f"left={left:.0f}s slug={market.slug}"
                )
                return

        decision_ask = float(ask)
        buy_cap = min(ask_max, decision_ask) + slip
        # never allow cap above ASK_MAX + slip
        buy_cap = min(buy_cap, ask_max + slip)

        # FOK adverse-slip / stale-cheap-fill: re-fetch book & estimate fill vs decision_ask
        # Prefer SKIP (allow re-quote next poll) over blind FOK into a bad/stale print.
        try:
            book2 = await get_book(session, token)
        except Exception:
            book2 = book
        est_fill = estimate_buy_fill(book2, cost)
        fresh_ask = best_ask(book2)
        if est_fill is None or est_fill <= 0:
            est_fill = float(fresh_ask) if fresh_ask and fresh_ask < 1.0 else decision_ask
        # If book moved cheaper, use the fresher implied print for hygiene
        implied = min(float(est_fill), float(fresh_ask) if fresh_ask < 1.0 else float(est_fill))
        adv_lim = float(CONFIG["ADVERSE_SLIP"])
        stale_ask_min = float(CONFIG["STALE_ASK_MIN"])
        stale_fill_max = float(CONFIG["STALE_FILL_MAX"])
        slip_vs_decision = float(decision_ask) - float(implied)
        if slip_vs_decision >= adv_lim - 1e-12:
            log.info(
                f"[DAXUE][SKIP] adverse-slip decision_ask={decision_ask:.3f} "
                f"est_fill={implied:.3f} slip={slip_vs_decision:.3f}>={adv_lim:.2f} "
                f"side={side} left={left:.0f}s slug={market.slug}"
            )
            return
        if decision_ask >= stale_ask_min - 1e-12 and implied <= stale_fill_max + 1e-12:
            log.info(
                f"[DAXUE][SKIP] stale-cheap-fill decision_ask={decision_ask:.3f}>="
                f"{stale_ask_min:.2f} est_fill={implied:.3f}<={stale_fill_max:.2f} "
                f"side={side} left={left:.0f}s slug={market.slug}"
            )
            return

        # Mark window claimed before order to avoid double-fire on slow FOK
        self._entered_slugs.add(market.slug)

        log.info(
            f"[DAXUE][LIVE][ENTRY] {side} ask={ask:.3f} band=[{ask_min:.2f},{ask_max:.2f}] "
            f"decision_ask={decision_ask:.3f} max_price={buy_cap:.3f} slip={slip:.2f} "
            f"spot={spot:.2f} open={open_px:.2f} delta={spot-open_px:+.2f} "
            f"cost=${cost:.2f} open_cost=${cur:.2f}/${max_deploy:.0f} "
            f"left={left:.0f}s slug={market.slug} price_cap=market_buy_maxPrice_FOK"
        )

        dry = bool(CONFIG["DRY_RUN"]) or not bool(CONFIG["POLYMARKET_LIVE"])
        resp = await place_order(
            market.slug,
            side.lower(),
            "BUY",
            cost,
            price=decision_ask,
            dry=dry,
            max_price=buy_cap,
            decision_ask=decision_ask,
        )
        ok = bool(resp.get("ok"))
        order_id = ""
        if isinstance(resp.get("response"), dict):
            order_id = str(
                resp["response"].get("orderID")
                or resp["response"].get("orderId")
                or resp["response"].get("id")
                or ""
            )
        fill_px = extract_fill_px(resp)
        bad_over = float(CONFIG["BAD_FILL_OVER"])
        bad_fill = bool(resp.get("badFill"))
        if fill_px is not None:
            if fill_px > decision_ask + bad_over or fill_px > ask_max + bad_over:
                bad_fill = True
        if ok and not bad_fill:
            pos = OpenPos(
                slug=market.slug,
                side=side,
                ask=ask,
                cost_usd=cost,
                market_end=market.end_ts,
                open_price=open_px,
                spot_at_entry=spot,
                ts=now,
                order_id=order_id,
                live_filled=not dry,
                fill_px=float(fill_px or 0),
                decision_ask=decision_ask,
                bad_fill=False,
            )
            self.open_positions.append(pos)
            save_open_positions(self.open_positions)
            tag = "DRY" if dry else "FILL"
            log.info(
                f"[DAXUE][{tag}] {side} decision_ask={decision_ask:.3f} "
                f"fill_px={fill_px if fill_px is not None else '-'} "
                f"max_price={buy_cap:.3f} slug={market.slug} "
                f"order_id={order_id or '-'} resp_ok=1 "
                f"priceCapMode={resp.get('priceCapMode','')} "
                f"funder={resp.get('funder','')} sig={resp.get('signatureTypeName','')}"
            )
        elif bad_fill:
            # Capital may be spent; still track deploy budget but flag loudly.
            pos = OpenPos(
                slug=market.slug,
                side=side,
                ask=ask,
                cost_usd=cost,
                market_end=market.end_ts,
                open_price=open_px,
                spot_at_entry=spot,
                ts=now,
                order_id=order_id,
                live_filled=not dry,
                fill_px=float(fill_px or 0),
                decision_ask=decision_ask,
                bad_fill=True,
            )
            self.open_positions.append(pos)
            save_open_positions(self.open_positions)
            log.error(
                f"[DAXUE][BAD_FILL] {side} decision_ask={decision_ask:.3f} "
                f"fill_px={fill_px if fill_px is not None else '-'} "
                f"max_price={buy_cap:.3f} ask_max={ask_max:.2f} "
                f"slug={market.slug} order_id={order_id or '-'} "
                f"— NOT counted as valid edge trade"
            )
        else:
            # allow retry later in same window on failed FOK / transient
            self._entered_slugs.discard(market.slug)
            err = resp.get("error") or resp.get("_stdout_tail") or str(resp)[:200]
            log.warning(
                f"[DAXUE][SKIP] order-fail {side} decision_ask={decision_ask:.3f} "
                f"max_price={buy_cap:.3f} slug={market.slug} err={err}"
            )

    async def run(self):
        write_pid()
        await self.bn.start()
        session = await create_session()
        try:
            geo = await check_geoblock(session)
            blocked = geo.get("blocked")
            if blocked is True:
                log.warning(f"[DAXUE][WARN] geoblock blocked=true geo={geo}")
            else:
                log.info(f"[DAXUE] geoblock blocked={blocked} geo={geo}")

            # Dry self-check of place_order client (no live order)
            dry_ok = False
            try:
                m0 = await find_btc5m(session)
                if m0 and m0.slug:
                    chk = await place_order(
                        m0.slug,
                        "up",
                        "BUY",
                        CONFIG["POSITION_USD"],
                        dry=True,
                        max_price=float(CONFIG["ASK_MAX"]) + float(CONFIG["BUY_SLIP"]),
                        decision_ask=float(CONFIG["ASK_MAX"]),
                    )
                    dry_ok = bool(chk.get("ok"))
                    log.info(
                        f"[DAXUE][SELFCHECK] place_order --dry ok={dry_ok} "
                        f"slug={m0.slug} sig={chk.get('signatureTypeName')} "
                        f"funder={chk.get('funder')} walletType={chk.get('walletType')} "
                        f"priceCapMode={chk.get('priceCapMode')} "
                        f"maxPrice={chk.get('maxPrice')}"
                    )
                else:
                    help_chk = await asyncio.to_thread(
                        place_order_sync,
                        "btc-updown-5m-0",
                        "up",
                        "BUY",
                        CONFIG["POSITION_USD"],
                        None,
                        True,
                    )
                    # help path not used; just note missing market
                    log.warning(
                        f"[DAXUE][SELFCHECK] no live market yet for dry slug check "
                        f"(help-path unused) detail={help_chk.get('error')}"
                    )
            except Exception as e:
                log.warning(f"[DAXUE][SELFCHECK] failed: {e}")

            max_run = float(CONFIG["MAX_RUN_SEC"] or 0)
            log.info(
                f"Started | mode=DAXUE_LIVE | strategy=大数投资/DAXUE | "
                f"POLYMARKET_LIVE={CONFIG['POLYMARKET_LIVE']} | "
                f"POSITION_USD={CONFIG['POSITION_USD']} | "
                f"ask_band=[{CONFIG['ASK_MIN']:.2f},{CONFIG['ASK_MAX']:.2f}] | "
                f"ask_max={CONFIG['ASK_MAX']:.2f} | "
                f"buy_slip={CONFIG['BUY_SLIP']:.2f} | "
                f"buy_cap=decision_ask+slip (maxPrice FOK) | "
                f"bad_fill_over={CONFIG['BAD_FILL_OVER']:.2f} | "
                f"open_tol=${CONFIG['OPEN_TOL_USD']:.0f} | "
                f"bankroll=${CONFIG['BANKROLL_USD']:.0f} | "
                f"max_deploy=${CONFIG['MAX_DEPLOY_USD']:.0f} | "
                f"max_legs≈{int(CONFIG['MAX_DEPLOY_USD'] // CONFIG['POSITION_USD'])} | "
                f"hold_to_settle=1 | one_entry_per_window=1 | "
                f"MAX_RUN_SEC={int(max_run) if max_run else 0} | "
                f"DRY_RUN={CONFIG['DRY_RUN']} | "
                f"selfcheck_dry_ok={dry_ok} | "
                f"open_restored={len(self.open_positions)} "
                f"cost=${self.open_cost():.2f} | "
                f"DAY_LOSS_STOP=${CONFIG['DAY_LOSS_STOP']:.2f} | "
                f"CONSEC_LOSS_PAUSE={CONFIG['CONSEC_LOSS_PAUSE']} | "
                f"PAUSE_MIN={CONFIG['PAUSE_MIN']} | "
                f"BIG_WIN_LOCK=${CONFIG['BIG_WIN_LOCK']:.2f} | "
                f"LOCK_GAINS={int(bool(CONFIG['LOCK_GAINS']))} | "
                f"DAY_PROFIT_LOCK=${CONFIG['DAY_PROFIT_LOCK']:.2f} | "
                f"DAILY_TARGET_SOFT=unused | "
                f"overnight_pause="
                f"{'ON' if CONFIG.get('OVERNIGHT_PAUSE', True) else 'OFF'}"
                f"={int(CONFIG['OVERNIGHT_PAUSE_START_H']):02d}-"
                f"{int(CONFIG['OVERNIGHT_PAUSE_END_H']):02d} Asia/Shanghai | "
                f"adverse_slip>={CONFIG['ADVERSE_SLIP']:.2f} | "
                f"stale_cheap="
                f"ask>={CONFIG['STALE_ASK_MIN']:.2f}&fill<={CONFIG['STALE_FILL_MAX']:.2f} | "
                f"day={self.day_risk.day} "
                f"day_pnl_settled=${self.day_risk.day_pnl_settled:+.2f} "
                f"streak_L={self.day_risk.consec_losses} "
                f"stopped={self.day_risk.day_loss_stopped or self.day_risk.lock_gains_stopped or self.day_risk.day_profit_stopped} | "
                f"proxy={os.environ.get('HTTPS_PROXY', '')}"
            )
            log.info(
                "[DAXUE][LIVE] ON: orders via node place_order.mjs "
                "price_cap=market_buy_maxPrice_FOK | "
                "tags [DAXUE][LIVE][ENTRY]|[SKIP]|[FILL]|[BAD_FILL]|[SETTLE]|"
                "[DAY_LOSS_STOP]|[CONSEC_LOSS_PAUSE]|[LOCK_GAINS]|[DAY_PROFIT_LOCK]|"
                "[overnight-pause]|[adverse-slip]|[stale-cheap-fill] | "
                "GUIDED_LIVE frozen — this process does not use lag+SR"
            )

            while True:
                now = time.time()
                if max_run > 0 and (now - self._start_ts) >= max_run:
                    log.info(f"[DAXUE] MAX_RUN_SEC={int(max_run)} reached — stopping cleanly")
                    break

                self.prune_settled(now)
                # Retry Gamma for pending freed legs ~every 60s
                if now - self._last_settle_retry >= 60.0:
                    self._last_settle_retry = now
                    try:
                        self.day_risk.retry_pending(max_n=8)
                        self.day_risk.check_day_loss(self.open_positions)
                    except Exception as e:
                        log.warning(f"[DAXUE] settle_retry: {e}")

                if self.bn.latest <= 0:
                    await asyncio.sleep(0.5)
                    continue

                market = await find_btc5m(session)
                if not market:
                    if now - self._last_hb >= CONFIG["HEARTBEAT_SEC"]:
                        self._last_hb = now
                        log.info(
                            f"[DAXUE] heartbeat: no market | btc={self.bn.latest:.0f} "
                            f"open_pos={len(self.open_positions)} cost=${self.open_cost():.2f}"
                        )
                    await asyncio.sleep(CONFIG["POLL_SEC"])
                    continue

                left = market.end_ts - now
                # Cache window open once (first spot seen for this end_ts)
                if market.end_ts not in self.open_cache:
                    self.open_cache[market.end_ts] = self.bn.latest
                    market.open_price = self.bn.latest
                    log.info(
                        f"[DAXUE] window open cached end={int(market.end_ts)} "
                        f"open={market.open_price:.2f} left={left:.0f}s slug={market.slug}"
                    )
                else:
                    market.open_price = self.open_cache[market.end_ts]

                try:
                    await self.maybe_enter(session, market, left, now)
                except Exception as e:
                    log.error(f"[DAXUE] maybe_enter error: {e}")

                if now - self._last_hb >= CONFIG["HEARTBEAT_SEC"]:
                    self._last_hb = now
                    side_hint = self.pick_side(self.bn.latest, market.open_price) or "-"
                    dr = self.day_risk
                    stop_tag = (
                        "DAY_LOSS_STOP"
                        if dr.day_loss_stopped
                        else (
                            "LOCK_GAINS"
                            if dr.lock_gains_stopped
                            else (
                                "DAY_PROFIT_LOCK"
                                if dr.day_profit_stopped
                                else (
                                    "CONSEC_PAUSE"
                                    if dr.pause_until > now
                                    else "ok"
                                )
                            )
                        )
                    )
                    log.info(
                        f"[DAXUE] heartbeat: left={left:.0f}s side_hint={side_hint} "
                        f"btc={self.bn.latest:.0f} open={market.open_price:.0f} "
                        f"delta={self.bn.latest - market.open_price:+.1f} "
                        f"open_pos={len(self.open_positions)} "
                        f"cost=${self.open_cost():.2f}/${CONFIG['MAX_DEPLOY_USD']:.0f} "
                        f"day_pnl=${dr.day_pnl_settled:+.2f} "
                        f"for_stop=${dr.day_pnl_for_stop(self.open_positions):+.2f} "
                        f"streak_L={dr.consec_losses} risk={stop_tag} "
                        f"slug={market.slug}"
                    )

                await asyncio.sleep(CONFIG["POLL_SEC"])
        finally:
            await session.close()
            save_open_positions(self.open_positions)
            log.info(
                f"[DAXUE] stopped | open_pos={len(self.open_positions)} "
                f"cost=${self.open_cost():.2f}"
            )


def main():
    bot = DaxueBot()
    try:
        asyncio.run(bot.run())
    except KeyboardInterrupt:
        log.info("[DAXUE] KeyboardInterrupt — exit")
    finally:
        try:
            if PID_FILE.is_file() and PID_FILE.read_text().strip() == str(os.getpid()):
                PID_FILE.unlink(missing_ok=True)
        except Exception:
            pass


if __name__ == "__main__":
    main()
