            f"POSITION_USD={CONFIG['POSITION_USD']} | "
            f"min_edge={CONFIG['MIN_LAG_EDGE']} | "
            f"MAX_RUN_SEC={int(max_run) if max_run else 0} | "
            f"REVIEW_PAUSE_EVERY={CONFIG.get('REVIEW_PAUSE_EVERY')} | "
            f"review_paused={self._review_paused} | "
            f"SR_LOOKBACK={CONFIG['SR_LOOKBACK_SEC']}s TOUCH={CONFIG['SR_TOUCH_PCT']} "
            f"SR_RES_MAX={CONFIG.get('SR_RESISTANCE_MAX_ASK', CONFIG['MAX_PRICE'])} "
            f"SR_SUP_MAX={CONFIG.get('SR_SUPPORT_MAX_ASK', CONFIG['MAX_PRICE'])} "
            f"SR_SUP_SKIP_TD={int(bool(CONFIG.get('SR_SUPPORT_SKIP_TREND_DOWN', True)))} "
            f"SR_SUP_TD_CD={int(float(CONFIG.get('SR_SUPPORT_TREND_DOWN_COOLDOWN_SEC', 0) or 0))}s "
            f"SR_SUP_OPEN_TOL={float(CONFIG.get('SR_SUPPORT_OPEN_TOL', 10)):.0f} "
            f"SR_RES_OPEN_TOL={float(CONFIG.get('SR_RESISTANCE_OPEN_TOL', 5)):.0f} "
            f"SR_SUP_DROP={float(CONFIG.get('SR_SUPPORT_DROP_USD', 40)):.0f}/{float(CONFIG.get('SR_SUPPORT_DROP_WINDOW_SEC', 180)):.0f}s "
            f"LAG_EDGE_LOG={float(CONFIG.get('LAG_EDGE_LOG_THRESHOLD', 0.06)):.2f} "
            f"RANGE_MAX={CONFIG['RANGE_MAX_PCT']} | "
            f"proxy={os.environ.get('HTTPS_PROXY', '')}"
        )
        if live:
            log.info(
                "LIVE guided ON: orders via node place_order.mjs "
                f"(cap ${CONFIG['POSITION_USD']:.2f}) | "
                "Alert paths: [ALERT][ENTRY]/[ALERT][EXIT] | lag [SIGNAL]"
            )
        else:
            log.info(
                "Alert paths live: [ALERT][ENTRY] 阻力/支撑 | [ALERT][EXIT] 横盘 | "
                "lag [SIGNAL] unchanged | "
                + ("GUIDED_AUTO paper entries/exits ON (no live orders)" if guided else "GUIDED_AUTO off")
            )
        await tg(f"Lag observe started ({mode})")

        try:
            while True:
                now = time.time()
                self._check_review_resume()
                if max_run > 0 and (now - self._start_ts) >= max_run:
                    log.info(f"MAX_RUN_SEC={int(max_run)} reached — stopping cleanly")
                    break

                # Human SR / range alerts — independent of Polymarket lag edge
                try:
                    self._check_sr_alerts(now)
                    self._check_range_exit(now)
                except Exception as e:
                    log.error(f"alert check: {e}")

                # GUIDED early exit can fire outside ENTRY_WINDOW (uses last cached bids)
                if (
                    CONFIG.get("GUIDED_AUTO")
                    and self._guided_open is not None
                    and self._guided_range_fire
                    and now - self._guided_range_fire <= 2.5
                ):
                    s = self._guided_open
                    bid = self._guided_books.get(s.side, 0.0) or 0.0
                    if bid > 0 and not s.resolved:
                        live_tag = "LIVE" if CONFIG.get("GUIDED_LIVE") else "PAPER"
                        sell_ok = True
                        if CONFIG.get("GUIDED_LIVE") and s.live_filled and s.slug:
                            try:
                                sh = (
                                    CONFIG["POSITION_USD"] / s.price
                                    if s.price and s.price > 0
                                    else 0.0
                                )
                                resp = await place_order(
                                    s.slug,
                                    s.side.lower(),
                                    "SELL",
                                    CONFIG["POSITION_USD"],
                                    shares=sh,
                                    price=s.price,
                                )
                                sell_ok = bool(resp.get("ok"))
                                if not sell_ok:
                                    log.error(
                                        f"[GUIDED][LIVE][EXIT] SELL failed "
                                        f"{s.side} slug={s.slug} resp={resp} — hold to resolve"
                                    )
                            except Exception as e:
                                sell_ok = False
                                log.error(
                                    f"[GUIDED][LIVE][EXIT] SELL exception {e} — hold to resolve"
                                )
                        if sell_ok:
                            shares = CONFIG["POSITION_USD"] / s.price
                            fee_in = shares * taker_fee_per_share(s.price)
                            fee_out = shares * taker_fee_per_share(bid)
                            s.exit_kind = "range_early"
                            s.exit_price = bid
                            s.fee = fee_in + fee_out
                            s.pnl = (bid - s.price) * shares
                            s.pnl_net = s.pnl - s.fee
                            s.won = s.pnl_net > 0
                            s.resolved = True
                            self.stats.resolved += 1
                            if s.won:
                                self.stats.wins += 1
                                self.stats.sum_win_pnl += s.pnl
                            else:
                                self.stats.losses += 1
                                self.stats.sum_loss_pnl += s.pnl
                            self.stats.total_pnl += s.pnl
                            self.stats.guided_pnl_net += s.pnl_net
                            self.stats.guided_early_exits += 1
                            log.info(
                                f"[GUIDED][{live_tag}][EXIT] range_early {s.side} "
                                f"bid={bid:.3f} pnl_net=${s.pnl_net:+.3f}"
                            )
                            asyncio.create_task(tg(
                                f"GUIDED {live_tag} EXIT range {s.side} bid={bid:.3f} "
                                f"pnl_net=${s.pnl_net:+.2f}"
                            ))
                            self._guided_open = None
                        # if sell failed: keep position open, do not crash
                    self._guided_range_fire = 0.0

                if now - self.stats.last_report >= CONFIG["STATS_INTERVAL_SEC"]:
                    self.stats.resolve_pending(self.bn.latest, now, self.open_cache)
                    summary = self.stats.summary()
                    log.info(f"=== STATS ===\n{summary}")
                    await tg(summary)
                    self.stats.last_report = now

                try:
                  market = await find_btc5m(session)
                except Exception as e:
                  log.error(f"find_btc5m: {e}")
                  await asyncio.sleep(4)
                  continue
                if not market:
                    if int(now) % 30 < 2:
                        hi, lo, n = self.bn.swing_high_low(CONFIG["SR_LOOKBACK_SEC"])
                        rpct, _, _, rn = self.bn.range_pct(CONFIG["RANGE_LOOKBACK_SEC"])
                        r_bps = f"{rpct*10000:.1f}bps" if rpct is not None else "n/a"
                        log.info(
                            f"heartbeat: no market | btc={self.bn.latest:.0f} | "
                            f"SR n={n} R={hi or 0:.0f}/S={lo or 0:.0f} | range={r_bps}"
                        )
                    await asyncio.sleep(4)
                    continue

                left = market.end_ts - now

                # Fix: cache window open once (was resetting to spot every tick → fair≈0.5)
                # Never cache 0 — wait for Binance ticks first. Needed before trend detect.
                cached = self.open_cache.get(market.end_ts)
                if cached is None or not (cached > 0):
                    elapsed = max(0.0, 300.0 - (market.end_ts - now))
                    px = self.bn.price_ago(elapsed) or self.bn.price_ago(15) or self.bn.latest
                    if not px or px <= 0:
                        # open not ready — keep classic window only
                        lo, hi = CONFIG["ENTRY_WINDOW_SEC"]
                        if not (lo <= left <= hi):
                            if int(now) % 20 < 2:
                                log.info(
                                    f"heartbeat: outside window left={left:.0f}s | "
                                    f"btc={self.bn.latest:.0f}"
                                )
                            await asyncio.sleep(2)
                            continue
                        if int(now) % 10 < 2:
                            log.info("waiting for Binance price before open cache")
                        await asyncio.sleep(0.8)
                        continue
                    self.open_cache[market.end_ts] = px
                    log.info(f"window open cached end={market.end_ts:.0f} open={px:.2f} elapsed={elapsed:.0f}s")
                market.open_price = self.open_cache[market.end_ts]

                trend = detect_window_trend(self.bn, market.open_price, now)
                if trend == "DOWN":
                    self._last_trend_down_ts = now
                if trend:
                    lo, hi = CONFIG["TREND_ENTRY_LEFT"]
                else:
                    lo, hi = CONFIG["ENTRY_WINDOW_SEC"]
                in_entry_window = lo <= left <= hi
                fresh_sr = bool(CONFIG.get("GUIDED_AUTO") and self._fresh_guided_sr(now))
                if not in_entry_window:
                    # Lag stays gated by window; fresh SR may still fetch books and enter
                    # but NEVER after market_end (post-window BUY ban).
                    if not fresh_sr or not market_window_open(left, now, market.end_ts):
                        if fresh_sr and not market_window_open(left, now, market.end_ts):
                            if int(now) % 20 < 2:
                                live_tag = "LIVE" if CONFIG.get("GUIDED_LIVE") else "PAPER"
                                kind = self._guided_sr_fire[0] if self._guided_sr_fire else "?"
                                log.info(
                                    f"[GUIDED][{live_tag}][ENTRY] {kind} skip post-window "
                                    f"left={left:.0f}s"
                                )
                        elif int(now) % 20 < 2:
                            log.info(
                                f"heartbeat: outside window left={left:.0f}s | "
                                f"trend={trend or '-'} | btc={self.bn.latest:.0f}"
                            )
                        await asyncio.sleep(2)
                        continue
                    if int(now) % 20 < 2:
                        log.info(
                            f"heartbeat: outside window left={left:.0f}s but fresh SR "
                            f"{self._guided_sr_fire[0]} — bypass for guided SR entry | "
                            f"btc={self.bn.latest:.0f}"
                        )

                if trend and (now - self._last_trend_window_log) >= 20:
                    win_move = (self.bn.latest - market.open_price) / market.open_price
                    log.info(
                        f"trend-window {trend} win_move={win_move:+.2%} left={left:.0f}s"
                    )
                    self._last_trend_window_log = now

                if abs(market.end_ts - self.last_signal_end) < 5:
                    await asyncio.sleep(1.5)
                    continue

                move = self.bn.recent_move(15)
                # When trend active, do NOT skip on tiny 15s move — keep path open for lag/SR
                # Fresh SR also bypasses low-move gate (lag still requires window via in_entry_window)
                fresh_sr = bool(CONFIG.get("GUIDED_AUTO") and self._fresh_guided_sr(now))
                if not trend and abs(move) < CONFIG["PRICE_MOVE_THRESHOLD"] and not fresh_sr:
                    if int(now) % 15 < 2:
                        log.info(
                            f"heartbeat: low move={move:+.5%} | left={left:.0f}s | btc={self.bn.latest:.0f}"
                        )
                    await asyncio.sleep(1.2)
                    continue

                try:
                  book_up = await get_book(session, market.token_up)
                  book_down = await get_book(session, market.token_down)
                except Exception as e:
                  log.error(f"get_book: {e}")
                  await asyncio.sleep(2)
                  continue
                ask_up = best_ask(book_up)
                ask_down = best_ask(book_down)
                bid_up = best_bid(book_up)
                bid_down = best_bid(book_down)

                if max(ask_up - bid_up, ask_down - bid_down) > CONFIG["MAX_SPREAD"]:
                    await asyncio.sleep(1.2)
                    continue

                fair_up = fair_from_distance(self.bn.latest, market.open_price)
                fair_down = 1.0 - fair_up
                edge_up = lag_edge(fair_up, ask_up)
                edge_down = lag_edge(fair_down, ask_down)

                chosen = None
                thr_move = CONFIG["PRICE_MOVE_THRESHOLD"]
                if trend == "UP":
                    # Continuous rally: treat as bullish UP; if 15s tiny or agrees, take UP
                    if (
                        edge_up >= CONFIG["MIN_LAG_EDGE"]
                        and CONFIG["MIN_PRICE"] <= ask_up <= CONFIG["MAX_PRICE"]
                        and (abs(move) < thr_move or move > 0)
                    ):
                        chosen = ("UP", ask_up, edge_up, fair_up)
                elif trend == "DOWN":
                    if (
                        edge_down >= CONFIG["MIN_LAG_EDGE"]
                        and CONFIG["MIN_PRICE"] <= ask_down <= CONFIG["MAX_PRICE"]
                        and (abs(move) < thr_move or move < 0)
                    ):
                        chosen = ("DOWN", ask_down, edge_down, fair_down)
                else:
                    if move > 0 and edge_up >= CONFIG["MIN_LAG_EDGE"] and CONFIG["MIN_PRICE"] <= ask_up <= CONFIG["MAX_PRICE"]:
                        chosen = ("UP", ask_up, edge_up, fair_up)
                    elif move < 0 and edge_down >= CONFIG["MIN_LAG_EDGE"] and CONFIG["MIN_PRICE"] <= ask_down <= CONFIG["MAX_PRICE"]:
                        chosen = ("DOWN", ask_down, edge_down, fair_down)

                log.info(
                    f"left={left:.0f}s move={move:+.4%} | "
                    f"BTC={self.bn.latest:.0f} open={market.open_price:.0f} | "
                    f"e_up={edge_up:+.3f} e_dn={edge_down:+.3f} | "
                    f"ask_u={ask_up:.3f} ask_d={ask_down:.3f} trend={trend or '-'}"
                )

                # Cache bids for guided early exit
                self._guided_books = {"UP": bid_up, "DOWN": bid_down, "ask_up": ask_up, "ask_down": ask_down}

                # Lag path stays inside classic/trend entry window even if SR bypassed continues
                if chosen and not in_entry_window:
                    chosen = None

                if chosen:
                    side, price, edge, fair = chosen
                    sig = Signal(
                        ts=now, side=side, price=price, fair=fair, edge=edge,
                        move=move, open_price=market.open_price, market_end=market.end_ts,
                        entry_kind="lag",
                        slug=market.slug or "",
                    )
                    self.stats.add(sig)
                    self.last_signal_end = market.end_ts
                    log.info(f"[SIGNAL] {side} @ {price:.3f} | fair={fair:.2f} edge={edge:+.3f}")
                    _elt = float(CONFIG.get("LAG_EDGE_LOG_THRESHOLD", 0.06) or 0)
                    if edge < _elt:
                        log.info(
                            f"[LAG][EDGE-LOW-WOULD-SKIP] edge={edge:+.3f} thr={_elt:.2f} "
                            f"side={side} ask={price:.3f} (log-only, still trading)"
                        )
                    await tg(f"SIGNAL {side} @ {price:.3f} | edge {edge:+.3f}")
                    if (
                        CONFIG.get("GUIDED_AUTO")
                        and self._guided_open is None
                        and not self._review_paused
                    ):
                        live_tag = "LIVE" if CONFIG.get("GUIDED_LIVE") else "PAPER"
                        if not market_window_open(left, now, market.end_ts):
                            log.info(
                                f"[GUIDED][{live_tag}][ENTRY] lag {side} skip post-window "
                                f"left={left:.0f}s"
                            )
                        else:
                            sig.slug = market.slug or ""
                            filled = True
                            if CONFIG.get("GUIDED_LIVE"):
                                if not sig.slug:
                                    log.error("[GUIDED][LIVE][ENTRY] missing slug — skip")
                                    filled = False
                                else:
                                    try:
                                        resp = await place_order(
                                            sig.slug,
                                            side.lower(),
                                            "BUY",
                                            CONFIG["POSITION_USD"],
                                        )
                                        filled = bool(resp.get("ok"))
                                        if not filled:
                                            log.error(
                                                f"[GUIDED][LIVE][ENTRY] BUY failed "
                                                f"{side} slug={sig.slug} resp={resp}"
                                            )
                                    except Exception as e:
                                        filled = False
                                        log.error(f"[GUIDED][LIVE][ENTRY] BUY exception {e}")
                            if filled:
                                sig.live_filled = bool(CONFIG.get("GUIDED_LIVE"))
                                self._guided_open = sig
                                save_pending_positions(self.stats.signals)
                                self.stats.guided_entries += 1
                                entry_line = (
                                    f"[GUIDED][{live_tag}][ENTRY] lag {side} @ {price:.3f} "
                                    f"slug={sig.slug} amt=${CONFIG['POSITION_USD']:.2f}"
                                )
                                log.info(entry_line)
                                self._maybe_review_pause_after_entry(entry_line)
                    elif (
                        CONFIG.get("GUIDED_AUTO")
                        and self._guided_open is None
                        and self._review_paused
                    ):
                        if int(now) % 30 < 2:
                            log.info(
                                f"[PAUSE][REVIEW] skip lag entry {side} — "
                                f"waiting for review resume "
                                f"(entries={self.stats.guided_entries})"
                            )

                # GUIDED_AUTO: SR entry if no lag fill this window and no open paper pos
                # (window / low-move may have been bypassed when _guided_sr_fire is fresh)
                if (
                    CONFIG.get("GUIDED_AUTO")
                    and self._guided_open is None
                    and not self._review_paused
                    and abs(market.end_ts - self.last_signal_end) >= 5
                    and self._guided_sr_fire
                ):
                    kind, fire_ts = self._guided_sr_fire
                    self._guided_sr_fire = None
                    if now - fire_ts <= 2.5:
                        sr_res_max = float(CONFIG.get("SR_RESISTANCE_MAX_ASK", CONFIG["MAX_PRICE"]))
                        sr_sup_max = float(CONFIG.get("SR_SUPPORT_MAX_ASK", CONFIG["MAX_PRICE"]))
                        if (
                            kind == "RESISTANCE"
                            and CONFIG["MIN_PRICE"] <= ask_down <= CONFIG["MAX_PRICE"]
                            and ask_down < sr_res_max
                        ):
                            open_tol_r = float(
                                CONFIG.get("SR_RESISTANCE_OPEN_TOL", 5) or 0
                            )
                            spot_r = float(self.bn.latest or 0)
                            win_open_r = float(market.open_price or 0)
                            if win_open_r > 0 and spot_r > (win_open_r + open_tol_r):
                                side, price = None, None
                                live_tag = "LIVE" if CONFIG.get("GUIDED_LIVE") else "PAPER"
                                log.info(
                                    f"[GUIDED][{live_tag}][ENTRY] RESISTANCE skip above-open "
                                    f"spot={spot_r:.2f} open={win_open_r:.2f} tol={open_tol_r:.2f} "
                                    f"ask={ask_down:.3f} left={left:.0f}s"
                                )
                            else:
                                side, price = "DOWN", ask_down
                        elif (
                            kind == "SUPPORT"
                            and CONFIG["MIN_PRICE"] <= ask_up <= CONFIG["MAX_PRICE"]
                            and ask_up < sr_sup_max
                        ):
                            td_cd = float(
                                CONFIG.get("SR_SUPPORT_TREND_DOWN_COOLDOWN_SEC", 0) or 0
                            )
                            in_td_cooldown = (
                                td_cd > 0
                                and self._last_trend_down_ts > 0
                                and (now - self._last_trend_down_ts) < td_cd
                            )
                            open_tol = float(CONFIG.get("SR_SUPPORT_OPEN_TOL", 10) or 0)
                            spot = float(self.bn.latest or 0)
                            win_open = float(market.open_price or 0)
                            drop_win = float(CONFIG.get("SR_SUPPORT_DROP_WINDOW_SEC", 180) or 0)
                            drop_thr = float(CONFIG.get("SR_SUPPORT_DROP_USD", 40) or 0)
                            try:
                                drop_amt, drop_span = support_drop_usd(
                                    self.bn.prices, spot, time.time(), drop_win
                                )
                            except Exception:
                                drop_amt, drop_span = None, 0.0
                            if (
                                drop_win > 0 and drop_thr > 0
                                and drop_amt is not None and drop_amt >= drop_thr
                            ):
                                side, price = None, None
                                live_tag = "LIVE" if CONFIG.get("GUIDED_LIVE") else "PAPER"
                                log.info(
                                    f"[GUIDED][{live_tag}][ENTRY] SUPPORT skip drop-momentum "
                                    f"drop=${drop_amt:.2f} thr=${drop_thr:.0f} win={drop_win:.0f}s "
                                    f"span={drop_span:.0f}s spot={spot:.2f} ask={ask_up:.3f} left={left:.0f}s"
                                )
                            elif win_open > 0 and spot < (win_open - open_tol):
                                side, price = None, None
                                live_tag = "LIVE" if CONFIG.get("GUIDED_LIVE") else "PAPER"
                                log.info(
                                    f"[GUIDED][{live_tag}][ENTRY] SUPPORT skip below-open "
                                    f"spot={spot:.2f} open={win_open:.2f} tol={open_tol:.2f} "
                                    f"ask={ask_up:.3f} left={left:.0f}s"
                                )
                            elif (
                                CONFIG.get("SR_SUPPORT_SKIP_TREND_DOWN", True)
                                and trend == "DOWN"
                            ):
                                side, price = None, None
                                live_tag = "LIVE" if CONFIG.get("GUIDED_LIVE") else "PAPER"
                                log.info(
                                    f"[GUIDED][{live_tag}][ENTRY] SUPPORT skip trend-window-down "
                                    f"ask={ask_up:.3f} left={left:.0f}s"
                                )
                            elif in_td_cooldown:
                                side, price = None, None
                                live_tag = "LIVE" if CONFIG.get("GUIDED_LIVE") else "PAPER"
                                age = now - self._last_trend_down_ts
                                log.info(
                                    f"[GUIDED][{live_tag}][ENTRY] SUPPORT skip trend-down-cooldown "
                                    f"ask={ask_up:.3f} age={age:.0f}s cd={td_cd:.0f}s left={left:.0f}s"
                                )
                            else:
                                side, price = "UP", ask_up
                        else:
                            side, price = None, None
                            ask_ref = ask_down if kind == "RESISTANCE" else ask_up
                            live_tag = "LIVE" if CONFIG.get("GUIDED_LIVE") else "PAPER"
                            if (
                                kind == "RESISTANCE"
                                and CONFIG["MIN_PRICE"] <= ask_ref <= CONFIG["MAX_PRICE"]
                                and ask_ref >= sr_res_max
                            ):
                                log.info(
                                    f"[GUIDED][{live_tag}][ENTRY] RESISTANCE skip ask-at-or-above-sr-res-max "
                                    f"ask={ask_ref:.3f} sr_res_max={sr_res_max:.2f} "
                                    f"band=[{CONFIG['MIN_PRICE']:.2f},{CONFIG['MAX_PRICE']:.2f}] "
                                    f"left={left:.0f}s"
                                )
                            elif (
                                kind == "SUPPORT"
                                and CONFIG["MIN_PRICE"] <= ask_ref <= CONFIG["MAX_PRICE"]
                                and ask_ref >= sr_sup_max
                            ):
                                log.info(
                                    f"[GUIDED][{live_tag}][ENTRY] SUPPORT skip ask-at-or-above-sr-sup-max "
                                    f"ask={ask_ref:.3f} sr_sup_max={sr_sup_max:.2f} "
                                    f"band=[{CONFIG['MIN_PRICE']:.2f},{CONFIG['MAX_PRICE']:.2f}] "
                                    f"left={left:.0f}s"
                                )
                            else:
                                log.info(
                                    f"[GUIDED][{live_tag}][ENTRY] {kind} skip ask-out-of-band "
                                    f"ask={ask_ref:.3f} band=[{CONFIG['MIN_PRICE']:.2f},{CONFIG['MAX_PRICE']:.2f}] "
                                    f"left={left:.0f}s"
                                )
                        if side:
                            live_tag = "LIVE" if CONFIG.get("GUIDED_LIVE") else "PAPER"
                            if not market_window_open(left, now, market.end_ts):
                                log.info(
                                    f"[GUIDED][{live_tag}][ENTRY] {kind} {side} skip post-window "
                                    f"left={left:.0f}s"
                                )
                                side = None  # abort BUY
                        if side:
                            sig = Signal(
                                ts=now, side=side, price=price, fair=0.0, edge=0.0,
                                move=move, open_price=market.open_price, market_end=market.end_ts,
                                entry_kind=kind,
                                slug=market.slug or "",
                            )
                            filled = True
                            live_tag = "LIVE" if CONFIG.get("GUIDED_LIVE") else "PAPER"
                            if CONFIG.get("GUIDED_LIVE"):
                                if not sig.slug:
                                    log.error("[GUIDED][LIVE][ENTRY] SR missing slug — skip")
                                    filled = False
                                else:
                                    try:
                                        resp = await place_order(
                                            sig.slug,
                                            side.lower(),
                                            "BUY",
                                            CONFIG["POSITION_USD"],
                                        )
                                        filled = bool(resp.get("ok"))
                                        if not filled:
                                            log.error(
                                                f"[GUIDED][LIVE][ENTRY] SR BUY failed "
                                                f"{kind} {side} slug={sig.slug} resp={resp}"
                                            )
                                    except Exception as e:
                                        filled = False
                                        log.error(f"[GUIDED][LIVE][ENTRY] SR BUY exception {e}")
                            if filled:
                                sig.live_filled = bool(CONFIG.get("GUIDED_LIVE"))
                                self.stats.add(sig)
                                self.last_signal_end = market.end_ts
                                self._guided_open = sig
                                save_pending_positions(self.stats.signals)
                                self.stats.guided_entries += 1
                                entry_line = (
                                    f"[GUIDED][{live_tag}][ENTRY] {kind} {side} @ {price:.3f} "
                                    f"slug={sig.slug} amt=${CONFIG['POSITION_USD']:.2f}"
                                )
                                log.info(entry_line)
                                await tg(
                                    f"GUIDED {live_tag} ENTRY {kind} {side} @ {price:.3f}"
                                )
                                self._maybe_review_pause_after_entry(entry_line)
                    else:
                        live_tag = "LIVE" if CONFIG.get("GUIDED_LIVE") else "PAPER"
                        log.info(
                            f"[GUIDED][{live_tag}][ENTRY] {kind} skip stale "
                            f"age={now - fire_ts:.2f}s (>2.5s)"
                        )

                if self._guided_open and now >= self._guided_open.market_end + 5:
                    self._guided_open = None  # resolve_pending will settle

                self.stats.resolve_pending(self.bn.latest, now, self.open_cache)
                await asyncio.sleep(1.2)

        finally:
            await session.close()
            if self.bn._task:
                self.bn._task.cancel()
            self.stats.resolve_pending(self.bn.latest, time.time(), self.open_cache)
            log.info(f"FINAL\n{self.stats.summary()}")

async def main():
    await ObserveBot().run()

if __name__ == "__main__":
    asyncio.run(main())
