PENDING_FILE = Path(__file__).resolve().parent / "logs" / "guided_pending_positions.json"
_OPEN_CACHE_REF: dict = {}  # set by ObserveBot; next-window opens persisted for restored settles

def save_pending_positions(signals) -> None:
    """Persist unresolved real live fills (accounting only; atomic write)."""
    try:
        rows = []
        for x in signals:
            if x.resolved or not getattr(x, "live_filled", False):
                continue
            rows.append({k: getattr(x, k) for k in (
                "ts", "side", "price", "fair", "edge", "move", "open_price", "market_end",
                "entry_kind", "exit_kind", "exit_price", "fee", "pnl", "pnl_net", "won", "slug")})
        PENDING_FILE.parent.mkdir(parents=True, exist_ok=True)
        tmp = PENDING_FILE.with_suffix(".json.tmp")
        oc = {}
        for r in rows:
            for k, v in list(_OPEN_CACHE_REF.items()):
                try:
                    if abs(float(k) - (float(r["market_end"]) + 300.0)) < 1.0 and v:
                        oc[str(int(float(k)))] = float(v)
                except Exception:
                    pass
        tmp.write_text(json.dumps({"updated": time.time(), "positions": rows, "open_cache": oc}, indent=2))
        os.replace(tmp, PENDING_FILE)
    except Exception as e:
        try:
            log.error(f"[PENDING] save failed: {e}")
        except Exception:
            pass

def load_pending_positions() -> list:
    try:
        if not PENDING_FILE.exists():
            return []
        data = json.loads(PENDING_FILE.read_text() or "{}")
        out = []
        for r in data.get("positions") or []:
            sig = Signal(**{k: v for k, v in r.items() if k in Signal.__dataclass_fields__})
            sig.live_filled = True
            sig.restored = True
            sig.resolved = False
            out.append(sig)
        for k, v in (data.get("open_cache") or {}).items():
            try:
                _OPEN_CACHE_REF.setdefault(float(k), float(v))
            except Exception:
                pass
        return out
    except Exception as e:
        try:
            log.error(f"[PENDING] load failed: {e}")
        except Exception:
            pass
        return []

@dataclass
class Stats:
    signals: list = field(default_factory=list)
    resolved: int = 0
    wins: int = 0
    losses: int = 0
    total_pnl: float = 0.0
    sum_win_pnl: float = 0.0
    sum_loss_pnl: float = 0.0
    last_report: float = field(default_factory=time.time)
    alerts_entry: int = 0
    alerts_exit: int = 0
    last_entry_alert_ts: float = 0.0
    last_exit_alert_ts: float = 0.0
    last_entry_kind: str = ""
    last_exit_kind: str = ""
    guided_entries: int = 0
    guided_early_exits: int = 0
    guided_pnl_net: float = 0.0

    def add(self, s: Signal):
        self.signals.append(s)

    def note_entry_alert(self, kind: str, ts: float):
        self.alerts_entry += 1
        self.last_entry_alert_ts = ts
        self.last_entry_kind = kind

    def note_exit_alert(self, kind: str, ts: float):
        self.alerts_exit += 1
        self.last_exit_alert_ts = ts
        self.last_exit_kind = kind

    def resolve_pending(self, current_btc: float, now: float, open_cache: Optional[dict] = None):
        """Settle hold-to-resolve signals.

        Prefer next-window open (open_cache[market_end+300]) as the window-boundary
        BTC proxy — closer to Polymarket/Chainlink settlement than a possibly-late
        spot tick (user 2026-10-22 ~17:31 after #52 on-chain loss vs accounting win).
        If next open is not cached yet, wait until market_end+90 then fall back to spot.
        """

        try:
            self._resolve_pending_inner(current_btc, now, open_cache)
        finally:
            save_pending_positions(self.signals)

    def _resolve_pending_inner(self, current_btc, now, open_cache):
        for s in self.signals:
            if s.resolved or now < s.market_end + 5:
                continue
            if s.exit_kind == "range_early":
                # already closed paper early; still count into resolved stats
                s.resolved = True
                self.resolved += 1
                won = bool(s.won)
                if won:
                    self.wins += 1
                    self.sum_win_pnl += s.pnl
                else:
                    self.losses += 1
                    self.sum_loss_pnl += s.pnl
                self.total_pnl += s.pnl
                self.guided_pnl_net += s.pnl_net
                if getattr(s, "restored", False):
                    log.info(f"[RESOLVE][RESTORED] range_early {s.side} slug={s.slug} pnl_net=${s.pnl_net:+.2f}")
                continue
            settle_btc = None
            settle_src = "spot"
            if open_cache:
                nxt = open_cache.get(s.market_end + 300.0)
                if nxt is None:
                    nxt = open_cache.get(int(s.market_end) + 300)
                if nxt is None:
                    # float/int key variants
                    for k, v in open_cache.items():
                        try:
                            if abs(float(k) - (float(s.market_end) + 300.0)) < 1.0 and v and v > 0:
                                nxt = v
                                break
                        except Exception:
                            continue
                if nxt and float(nxt) > 0:
                    settle_btc = float(nxt)
                    settle_src = "next_window_open"
            if settle_btc is None:
                if now < s.market_end + 90:
                    # wait for next-window open cache before falling back to spot
                    continue
                settle_btc = float(current_btc)
                settle_src = "spot_fallback"
            won = (s.side == "UP" and settle_btc >= s.open_price) or \
                  (s.side == "DOWN" and settle_btc < s.open_price)
            shares = CONFIG["POSITION_USD"] / s.price
            s.pnl = (1.0 - s.price) * shares if won else -s.price * shares
            fee = shares * taker_fee_per_share(s.price)
            s.fee = fee
            s.pnl_net = s.pnl - fee
            s.exit_kind = "resolve"
            s.won = won
            s.resolved = True
            self.resolved += 1
            if won:
                self.wins += 1
                self.sum_win_pnl += s.pnl
            else:
                self.losses += 1
                self.sum_loss_pnl += s.pnl
            self.total_pnl += s.pnl
            # Only count real fills into guided pnl when live (paper lag signals whose
            # BUY failed, e.g. FAK no-match, must not inflate pnl — review 2026-10-22 21:38)
            counted = bool(CONFIG.get("GUIDED_AUTO")) and (
                not CONFIG.get("GUIDED_LIVE") or bool(getattr(s, "live_filled", False))
            )
            if counted:
                self.guided_pnl_net += s.pnl_net
            try:
                log.info(
                    f"[RESOLVE]{'[RESTORED]' if getattr(s, 'restored', False) else ''}{'' if counted else '[PAPER-ONLY]'} {s.side} slug={s.slug or '-'} "
                    f"settle={settle_btc:.2f} src={settle_src} open={s.open_price:.2f} "
                    f"won={won} pnl_net=${s.pnl_net:+.2f}"
                )
            except Exception:
                pass

    def win_rate(self) -> float:
        return self.wins / self.resolved if self.resolved else 0.0

    def avg_win(self) -> float:
        return self.sum_win_pnl / self.wins if self.wins else 0.0

    def avg_loss(self) -> float:
        return abs(self.sum_loss_pnl) / self.losses if self.losses else 0.0

    def profit_factor(self) -> float:
        if self.sum_loss_pnl == 0:
            return float("inf") if self.sum_win_pnl > 0 else 0.0
        return self.sum_win_pnl / abs(self.sum_loss_pnl)

    def payoff_ratio(self) -> float:
        al = self.avg_loss()
        return self.avg_win() / al if al > 0 else 0.0

    def expected_value(self) -> float:
        if self.resolved == 0:
            return 0.0
        wr = self.win_rate()
        return wr * self.avg_win() - (1 - wr) * self.avg_loss()

    def _fmt_ago(self, ts: float, now: float) -> str:
        if ts <= 0:
            return "never"
        return f"{now - ts:.0f}s ago"

    def summary(self) -> str:
        now = time.time()
        alert_line = (
            f"Alerts: entry={self.alerts_entry} (last={self.last_entry_kind or '-'}"
            f" {self._fmt_ago(self.last_entry_alert_ts, now)}) | "
            f"exit={self.alerts_exit} (last={self.last_exit_kind or '-'}"
            f" {self._fmt_ago(self.last_exit_alert_ts, now)})"
        )
        if CONFIG.get("GUIDED_AUTO") or CONFIG.get("GUIDED_LIVE"):
            tag = "guided_live" if CONFIG.get("GUIDED_LIVE") else "guided_paper"
            alert_line += (
                f" | {tag}: entries={self.guided_entries} "
                f"early_exits={self.guided_early_exits} "
                f"pnl_net=${self.guided_pnl_net:+.2f}"
            )
        if self.resolved == 0:
            return (
                f"Signals: {len(self.signals)} | Resolved: 0 | (waiting)\n"
                f"  {alert_line}"
            )
        wr = self.win_rate() * 100
        pf = self.profit_factor()
        pr = self.payoff_ratio()
        ev = self.expected_value()
        pf_str = "inf" if pf == float("inf") else f"{pf:.2f}"
        return (
            f"Signals: {len(self.signals)} | Resolved: {self.resolved}\n"
            f"  Win Rate: {wr:.1f}% ({self.wins}W / {self.losses}L)\n"
            f"  Profit Factor: {pf_str}  |  Payoff Ratio: {pr:.2f}\n"
            f"  EV per trade: ${ev:+.2f}  |  Total PnL: ${self.total_pnl:+.2f}\n"
            f"  {alert_line}"
        )

class BinanceFeed:
    def __init__(self):
        self.prices = []
        self.latest = 0.0
        self._task = None

    async def start(self):
        self._task = asyncio.create_task(self._run())

    async def _run(self):
        url = "wss://data-stream.binance.vision/ws/btcusdt@trade"  # stream.binance.com returns 451/timeout in this env
        while True:
            try:
                async with websockets.connect(url, ping_interval=20) as ws:
                    log.info("Binance WS connected")
                    async for raw in ws:
                        data = json.loads(raw)
                        price = float(data["p"])
                        now = time.time()
                        self.latest = price
                        self.prices.append(PricePoint(now, price))
                        # Retain enough history for SR 1h lookback (and RANGE); was 180s
                        _retain = max(
                            float(CONFIG.get("SR_LOOKBACK_SEC", 3600)),
                            float(CONFIG.get("RANGE_LOOKBACK_SEC", 120)),
                            180.0,
                        ) + 30.0
                        self.prices = [p for p in self.prices if p.ts > now - _retain]
            except Exception as e:
                log.error(f"Binance error: {e}")
                await asyncio.sleep(2)

    def recent_move(self, seconds: int = 15) -> float:
        if not self.prices:
            return 0.0
        now = time.time()
        past = [p.price for p in self.prices if now - p.ts <= seconds]
        if len(past) < 2:
            return 0.0
        return (self.latest - past[0]) / past[0]

    def price_ago(self, seconds: float) -> Optional[float]:
        target = time.time() - seconds
        for p in reversed(self.prices):
            if p.ts <= target:
                return p.price
        return None

    def window_prices(self, lookback_sec: float) -> list:
        if not self.prices:
            return []
        now = time.time()
        return [p for p in self.prices if now - p.ts <= lookback_sec]

    def swing_high_low(self, lookback_sec: float) -> Tuple[Optional[float], Optional[float], int]:
        """Lookback-window high (=resistance) and low (=support); lookback from SR_LOOKBACK_SEC (1h)."""
        pts = self.window_prices(lookback_sec)
        if len(pts) < 5:
            return None, None, len(pts)
        prices = [p.price for p in pts]
        return max(prices), min(prices), len(pts)

    def range_pct(self, lookback_sec: float) -> Tuple[Optional[float], Optional[float], Optional[float], int]:
        """Return (range_pct, high, low, n) where range_pct = (high-low)/mid."""
        pts = self.window_prices(lookback_sec)
        n = len(pts)
        if n < 2:
            return None, None, None, n
        prices = [p.price for p in pts]
        hi, lo = max(prices), min(prices)
        mid = (hi + lo) / 2.0
        if mid <= 0:
            return None, hi, lo, n
        return (hi - lo) / mid, hi, lo, n


async def create_session():
    # trust_env=True so HTTPS_PROXY / HTTP_PROXY are honored
    return aiohttp.ClientSession(
        connector=aiohttp.TCPConnector(ssl=False),
        timeout=aiohttp.ClientTimeout(total=12),
        trust_env=True,
    )


def place_order_sync(
    slug: str,
    outcome: str,
    side: str,
    amount: float,
    shares: Optional[float] = None,
    price: Optional[float] = None,
) -> dict:
    """Call node place_order.mjs; returns parsed JSON + ok flag. Never logs secrets.
    BUY: amount = USD notional (capped). SELL: pass shares (or amount+price to derive).
    """
    js = CONFIG.get("PLACE_ORDER_JS") or str(SCRIPT_DIR / "place_order.mjs")
    amt = min(float(amount), float(CONFIG["POSITION_USD"]))
    if amt <= 0 and not (shares and shares > 0):
        return {"ok": False, "error": "amount_zero"}
    cmd = [
        "node",
        js,
        "--slug", str(slug),
        "--outcome", str(outcome).lower(),
        "--side", str(side).upper(),
        "--amount", f"{max(amt, 0.01):.2f}",
    ]
    if shares is not None and shares > 0:
        cmd.extend(["--shares", f"{float(shares):.4f}"])
    if price is not None and price > 0:
        cmd.extend(["--price", f"{float(price):.4f}"])
    env = os.environ.copy()
    env.setdefault("HTTPS_PROXY", "http://127.0.0.1:7890")
    env.setdefault("HTTP_PROXY", "http://127.0.0.1:7890")
    env.setdefault("ALL_PROXY", "http://127.0.0.1:7890")
    env.setdefault("NODE_OPTIONS", "--use-env-proxy")
    try:
        proc = subprocess.run(
            cmd,
            cwd=str(SCRIPT_DIR),
            env=env,
            capture_output=True,
            text=True,
            timeout=60,
        )
    except Exception as e:
        return {"ok": False, "error": f"subprocess: {e}"}
    raw = (proc.stdout or "").strip() or (proc.stderr or "").strip()
    parsed = None
    try:
        # last JSON object in stdout
        if raw:
            # try full stdout first
            try:
                parsed = json.loads(raw)
            except Exception:
                # find last {...} block
                i = raw.rfind("{")
                if i >= 0:
                    parsed = json.loads(raw[i:])
    except Exception:
        parsed = None
    ok = proc.returncode == 0 and isinstance(parsed, dict) and parsed.get("ok", True) is not False
    if isinstance(parsed, dict):
        parsed = dict(parsed)
        parsed["ok"] = bool(ok)
        parsed["_returncode"] = proc.returncode
        return parsed
    return {
        "ok": False,
        "error": "bad_response",
        "_returncode": proc.returncode,
        "_stdout_tail": raw[-300:] if raw else "",
    }



