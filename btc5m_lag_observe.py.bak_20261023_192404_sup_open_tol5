    def _load_review_pause_state(self):
        """Restore lifetime counters / pause flag from marker (survives MAX_RUN restarts)."""
        data = {}
        if REVIEW_PAUSE_MARKER.is_file():
            try:
                data = json.loads(REVIEW_PAUSE_MARKER.read_text(encoding="utf-8"))
            except Exception as e:
                log.error(f"[PAUSE][REVIEW] marker read failed: {e}")
                data = {}
        self._lifetime_entries = int(data.get("lifetime_entries") or 0)
        self._reviewed_lifetime_entries = int(
            data.get("reviewed_lifetime_entries") or 0
        )
        # Migrate older markers that only had in-session entries
        if "lifetime_entries" not in data and data.get("entries") is not None:
            # Best-effort: treat prior session entries as already reviewed floor
            prev = int(data.get("entries") or 0)
            if data.get("review_done"):
                self._lifetime_entries = max(self._lifetime_entries, prev)
                self._reviewed_lifetime_entries = max(
                    self._reviewed_lifetime_entries, prev
                )
        recent = data.get("recent_entries") or []
        if isinstance(recent, list):
            self._review_entry_lines = [str(x) for x in recent][-20:]
        force = _truthy(os.getenv("GUIDED_FORCE_PAUSE", "0"))
        paused_marker = bool(data.get("paused"))
        review_done = bool(data.get("review_done"))
        if force:
            self._review_paused = True
        elif paused_marker and not review_done:
            # Mid-pause across restart: keep blocking new BUYs
            self._review_paused = True
            log.info(
                "[PAUSE][REVIEW] restored paused=true from marker "
                f"(lifetime={self._lifetime_entries} "
                f"reviewed={self._reviewed_lifetime_entries})"
            )
        else:
            # review_done or unpaused: continue trading; floor is reviewed_lifetime_entries
            self._review_paused = False
        log.info(
            "[PAUSE][REVIEW] state loaded | "
            f"lifetime_entries={self._lifetime_entries} "
            f"reviewed_lifetime_entries={self._reviewed_lifetime_entries} "
            f"pending={self._lifetime_entries - self._reviewed_lifetime_entries} "
            f"paused={self._review_paused}"
        )

    def _write_review_pause_marker(self, paused: bool, review_done: Optional[bool] = None):
        """Write/update logs/guided_review_pause.json for the review routine.

        Preserves reviewed_* / report_path / auto_applied when present. On a fresh
        pause (paused=True), clears review_done so the 五笔复盘 routine can run.
        After review, the routine should set review_done=true and
        reviewed_lifetime_entries = lifetime_entries (same file).
        """
        try:
            REVIEW_PAUSE_MARKER.parent.mkdir(parents=True, exist_ok=True)
            prev = {}
            if REVIEW_PAUSE_MARKER.is_file():
                try:
                    prev = json.loads(REVIEW_PAUSE_MARKER.read_text(encoding="utf-8"))
                except Exception:
                    prev = {}
            at = datetime.now().astimezone().isoformat(timespec="seconds")
            payload = {
                "paused": bool(paused),
                "entries": int(self.stats.guided_entries),
                "lifetime_entries": int(self._lifetime_entries),
                "reviewed_lifetime_entries": int(self._reviewed_lifetime_entries),
                "at": at,
                "log": None,
                "pid": os.getpid(),
                "review_pause_every": int(CONFIG.get("REVIEW_PAUSE_EVERY") or 5),
                "recent_entries": list(self._review_entry_lines[-5:]),
            }
            # Preserve review metadata unless this write is a new pause gate
            if review_done is not None:
                payload["review_done"] = bool(review_done)
            elif paused:
                payload["review_done"] = False
            elif "review_done" in prev:
                payload["review_done"] = prev.get("review_done")
            for k in (
                "reviewed_at",
                "reviewed_entries",
                "report_path",
                "auto_applied",
                "catch_up",
                "catch_up_note",
            ):
                if k in prev and k not in payload:
                    payload[k] = prev[k]
            logpath_file = SCRIPT_DIR / "logs" / "guided_live.logpath"
            if logpath_file.is_file():
                try:
                    payload["log"] = logpath_file.read_text(encoding="utf-8").strip() or None
                except Exception:
                    pass
            elif prev.get("log"):
                payload["log"] = prev.get("log")
            REVIEW_PAUSE_MARKER.write_text(
                json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
                encoding="utf-8",
            )
        except Exception as e:
            log.error(f"[PAUSE][REVIEW] marker write failed: {e}")

    def _check_review_resume(self):
        """Resume if GUIDED_RESUME=1 or logs/guided_review_resume.flag exists."""
        resume_env = _truthy(os.getenv("GUIDED_RESUME", "0"))
        flag_exists = REVIEW_RESUME_FLAG.is_file()
        if not (resume_env or flag_exists):
            return
        was = self._review_paused
        self._review_paused = False
        if "GUIDED_RESUME" in os.environ:
            os.environ["GUIDED_RESUME"] = "0"
        if flag_exists:
            try:
                REVIEW_RESUME_FLAG.unlink()
            except Exception as e:
                log.error(f"[PAUSE][REVIEW] resume flag delete failed: {e}")
        # If a review just finished, floor should already equal lifetime; re-read to sync
        try:
            if REVIEW_PAUSE_MARKER.is_file():
                data = json.loads(REVIEW_PAUSE_MARKER.read_text(encoding="utf-8"))
                if "reviewed_lifetime_entries" in data:
                    self._reviewed_lifetime_entries = int(
                        data.get("reviewed_lifetime_entries") or 0
                    )
                if "lifetime_entries" in data:
                    self._lifetime_entries = max(
                        self._lifetime_entries,
                        int(data.get("lifetime_entries") or 0),
                    )
        except Exception as e:
            log.error(f"[PAUSE][REVIEW] resume re-read failed: {e}")
        self._write_review_pause_marker(paused=False)
        pending = self._lifetime_entries - self._reviewed_lifetime_entries
        log.info(
            f"[PAUSE][REVIEW] RESUME — new entries allowed again "
            f"(was_paused={was} via_env={resume_env} via_flag={flag_exists} "
            f"session_entries={self.stats.guided_entries} "
            f"lifetime={self._lifetime_entries} reviewed={self._reviewed_lifetime_entries} "
            f"pending={pending})"
        )

    def _maybe_review_pause_after_entry(self, entry_line: str):
        """After a successful guided live fill, pause every REVIEW_PAUSE_EVERY *lifetime* fills."""
        if not CONFIG.get("GUIDED_LIVE"):
            return
        self._review_entry_lines.append(entry_line)
        if len(self._review_entry_lines) > 20:
            self._review_entry_lines = self._review_entry_lines[-20:]
        self._lifetime_entries = int(self._lifetime_entries) + 1
        every = int(CONFIG.get("REVIEW_PAUSE_EVERY") or 5)
        pending = self._lifetime_entries - self._reviewed_lifetime_entries
        # Persist counter on every fill so restarts do not lose progress
        should_pause = (
            every > 0
            and pending > 0
            and pending % every == 0
        )
        if should_pause:
            self._review_paused = True
            self._write_review_pause_marker(paused=True, review_done=False)
            log.info(
                f"[PAUSE][REVIEW] lifetime_entries={self._lifetime_entries} "
                f"pending={pending} (session={self.stats.guided_entries}) — "
                f"new entries paused until review resume"
            )
        else:
            self._write_review_pause_marker(paused=bool(self._review_paused))

    def _fresh_guided_sr(self, now: float) -> bool:
        """True when a SUPPORT/RESISTANCE fire is still within the ~2.5s entry grace."""
        if not self._guided_sr_fire:
            return False
        _kind, fire_ts = self._guided_sr_fire
        return (now - fire_ts) <= 2.5

    def _check_sr_alerts(self, now: float):
        """Independent human ENTRY alerts from swing high/low touch+reject."""
        if self.bn.latest <= 0:
            return
        lookback = CONFIG["SR_LOOKBACK_SEC"]
        hi, lo, n = self.bn.swing_high_low(lookback)
        if hi is None or lo is None or n < 10:
            return
        btc = self.bn.latest
        touch = CONFIG["SR_TOUCH_PCT"]
        reject = CONFIG["SR_REJECT_MOVE"]
        cd = CONFIG["SR_COOLDOWN_SEC"]
        self._sr_logic_alive_at = now

        # Resistance: near high then tick down
        if hi > 0 and abs(btc - hi) / hi <= touch:
            self._sr_touched["RESISTANCE"] = True
            self._sr_touch_price["RESISTANCE"] = hi
        elif self._sr_touched["RESISTANCE"]:
            R = self._sr_touch_price["RESISTANCE"] or hi
            if R > 0 and (R - btc) / R >= reject:
                last_t = self._last_sr_alert["RESISTANCE"]
                same_lvl = abs(R - self._last_sr_level["RESISTANCE"]) / R < touch if self._last_sr_level["RESISTANCE"] else False
                if now - last_t >= cd or not same_lvl:
                    msg = (
                        f"[ALERT][ENTRY] 阻力位受阻 | BTC={btc:.2f} R={R:.2f} | "
                        f"建议关注 DOWN / 减多"
                    )
                    log.info(msg)
                    self.stats.note_entry_alert("RESISTANCE", now)
                    self._last_sr_alert["RESISTANCE"] = now
                    self._last_sr_level["RESISTANCE"] = R
                    self._guided_sr_fire = ("RESISTANCE", now)
                    asyncio.create_task(tg(msg))
                self._sr_touched["RESISTANCE"] = False

        # Support: near low then tick up
        if lo > 0 and abs(btc - lo) / lo <= touch:
            self._sr_touched["SUPPORT"] = True
            self._sr_touch_price["SUPPORT"] = lo
        elif self._sr_touched["SUPPORT"]:
            S = self._sr_touch_price["SUPPORT"] or lo
            if S > 0 and (btc - S) / S >= reject:
                last_t = self._last_sr_alert["SUPPORT"]
                same_lvl = abs(S - self._last_sr_level["SUPPORT"]) / S < touch if self._last_sr_level["SUPPORT"] else False
                if now - last_t >= cd or not same_lvl:
                    msg = (
                        f"[ALERT][ENTRY] 支撑位反弹 | BTC={btc:.2f} S={S:.2f} | "
                        f"建议关注 UP / 减空"
                    )
                    log.info(msg)
                    self.stats.note_entry_alert("SUPPORT", now)
                    self._last_sr_alert["SUPPORT"] = now
                    self._last_sr_level["SUPPORT"] = S
                    self._guided_sr_fire = ("SUPPORT", now)
                    asyncio.create_task(tg(msg))
                self._sr_touched["SUPPORT"] = False

    def _check_range_exit(self, now: float):
        """Independent human EXIT alert when realized range is flat chop."""
        if self.bn.latest <= 0:
            return
        lookback = CONFIG["RANGE_LOOKBACK_SEC"]
        min_n = CONFIG["RANGE_MIN_SAMPLES"]
        max_pct = CONFIG["RANGE_MAX_PCT"]
        cd = CONFIG["RANGE_COOLDOWN_SEC"]
        rpct, hi, lo, n = self.bn.range_pct(lookback)
        if rpct is None or n < min_n:
            return
        if rpct > max_pct:
            return
        if now - self._last_range_alert < cd:
            return
        btc = self.bn.latest
        bps = rpct * 10000.0
        msg = (
            f"[ALERT][EXIT] 明显横盘震荡 | range={bps:.1f}bps | "
            f"BTC={btc:.2f} | 建议离场/减仓观望"
        )
        log.info(msg)
        self.stats.note_exit_alert("RANGE", now)
        self._last_range_alert = now
        self._guided_range_fire = now
        asyncio.create_task(tg(msg))

    async def run(self):
        await self.bn.start()
        session = await create_session()
        live = bool(CONFIG.get("GUIDED_LIVE"))
        guided = bool(CONFIG.get("GUIDED_AUTO"))
        if live:
            mode = "GUIDED_LIVE"
        elif CONFIG["OBSERVE"]:
