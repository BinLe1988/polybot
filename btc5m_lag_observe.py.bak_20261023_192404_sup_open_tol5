def best_ask(book: dict) -> float:
    asks = book.get("asks") or []
    if not asks:
        return 1.0
    return min(float(a["price"]) for a in asks)

def best_bid(book: dict) -> float:
    bids = book.get("bids") or []
    if not bids:
        return 0.0
    return max(float(b["price"]) for b in bids)

def fair_from_distance(btc: float, open_price: float) -> float:
    if open_price <= 0 or btc <= 0:
        return 0.5
    dist = (btc - open_price) / open_price
    score = dist * 1200
    p = 1 / (1 + math.exp(-score))
    return max(0.08, min(0.92, p))

def support_drop_usd(prices, latest: float, now: float, window_sec: float):
    """Return (drop, span_sec): price at/just before now-window minus latest.
    If history shorter than window, uses earliest available point. (None,0) if no data."""
    if not prices or not latest:
        return None, 0.0
    target = now - window_sec
    ref = None
    for pt in reversed(prices):
        if pt.ts <= target:
            ref = pt
            break
    if ref is None:
        ref = prices[0]
    return float(ref.price) - float(latest), max(0.0, now - ref.ts)


def lag_edge(fair: float, ask: float) -> float:
    return fair - ask - taker_fee_per_share(ask)

def detect_window_trend(bn, open_price: float, now: float = 0.0) -> Optional[str]:
    """Continuous rally/pullback vs window open + same-sign confirm over TREND_CONFIRM_SEC.
    Returns "UP", "DOWN", or None.
    """
    if not open_price or open_price <= 0 or not bn or not getattr(bn, "latest", 0):
        return None
    latest = bn.latest
    if latest <= 0:
        return None
    win_move = (latest - open_price) / open_price
    confirm = bn.recent_move(int(CONFIG["TREND_CONFIRM_SEC"]))
    thr = float(CONFIG["TREND_MOVE_PCT"])
    if win_move >= thr and confirm > 0:
        return "UP"
    if win_move <= -thr and confirm < 0:
        return "DOWN"
    return None

class ObserveBot:
