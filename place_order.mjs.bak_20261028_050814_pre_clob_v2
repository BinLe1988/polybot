#!/usr/bin/env node
/**
 * Limited live order helper.
 * Caps every order by POLYMARKET_MAX_ORDER_USD (env file or process.env).
 *
 * Uses @polymarket/clob-client with EXPLICIT Poly Proxy path:
 *   signatureType = POLYMARKET_SIGNATURE_TYPE (default 1 = POLY_PROXY)
 *   funder        = POLYMARKET_FUNDER_ADDRESS || POLYMARKET_WALLET_ADDRESS
 *
 * createSecureClient auto-classify mislabels this account as DEPOSIT_WALLET +
 * SESSION_KEY when the proxy is not the SDK's CREATE2-derived address — that
 * caused "order signer address has to be the address of the API KEY".
 *
 * Usage:
 *   node place_order.mjs --slug btc-updown-5m-<ts> --outcome up|down --side BUY|SELL --amount 2
 *   node place_order.mjs --slug ... --outcome down --side BUY --amount 2 --dry
 *
 * Exit 0 only if response.ok (or --dry succeeded). Prints JSON.
 * Never prints private keys or API secrets.
 */
import { ClobClient, OrderType, Side } from "@polymarket/clob-client";
import { Wallet } from "@ethersproject/wallet";
import { createPublicClient } from "@polymarket/client";
import { loadEnv, parseArgs } from "./lib_env.mjs";

const SIG_NAMES = {
  0: "EOA",
  1: "POLY_PROXY",
  2: "POLY_GNOSIS_SAFE",
  3: "POLY_1271",
};

function maskAddr(a) {
  const s = String(a || "");
  if (s.length < 10) return s ? "***" : "";
  return `${s.slice(0, 6)}…${s.slice(-4)}`;
}

/** Same pattern as strategy_btc5m_cs.mjs */
function assetIdForOutcome(market, names) {
  const entries = Object.entries(market.outcomes || {});
  for (const want of names) {
    for (const [k, v] of entries) {
      if (String(k).toLowerCase() === want.toLowerCase()) {
        return market.version === "v2" ? v.positionId : v.tokenId;
      }
    }
  }
  for (const [, v] of entries) {
    const n = String(v?.name || "").toLowerCase();
    if (names.some((w) => n === w.toLowerCase())) {
      return market.version === "v2" ? v.positionId : v.tokenId;
    }
  }
  return null;
}

function outcomeNames(outcome) {
  const o = String(outcome || "").toLowerCase();
  if (o === "up" || o === "yes") return ["Up", "yes", "UP", "Yes"];
  if (o === "down" || o === "no") return ["Down", "no", "DOWN", "No"];
  return null;
}

function resolveSignatureType(raw) {
  if (raw == null || raw === "") return 1;
  const s = String(raw).trim().toUpperCase();
  if (s === "POLY_PROXY" || s === "PROXY") return 1;
  if (s === "EOA") return 0;
  if (s === "POLY_GNOSIS_SAFE" || s === "GNOSIS_SAFE" || s === "SAFE") return 2;
  const n = Number(s);
  return Number.isFinite(n) ? n : 1;
}

async function buildClobClient(cfg) {
  const host = "https://clob.polymarket.com";
  const chainId = 137;
  const signatureType = resolveSignatureType(
    process.env.POLYMARKET_SIGNATURE_TYPE ?? cfg.signatureType
  );
  const funder =
    process.env.POLYMARKET_FUNDER_ADDRESS ||
    process.env.POLYMARKET_WALLET_ADDRESS ||
    cfg.funder ||
    cfg.wallet;
  const signer = new Wallet(cfg.privateKey);
  const creds = await new ClobClient(host, chainId, signer).createOrDeriveApiKey();
  const client = new ClobClient(
    host,
    chainId,
    signer,
    creds,
    signatureType,
    funder
  );
  return {
    client,
    signer,
    funder,
    signatureType: client.orderBuilder.signatureType,
    signatureTypeName:
      SIG_NAMES[client.orderBuilder.signatureType] ||
      String(client.orderBuilder.signatureType),
    walletType:
      SIG_NAMES[client.orderBuilder.signatureType] === "POLY_PROXY"
        ? "POLY_PROXY"
        : SIG_NAMES[client.orderBuilder.signatureType] || "UNKNOWN",
    signerType: "OWNER",
  };
}

const args = parseArgs();
const cfg = loadEnv();
const MAX = Number(
  process.env.POLYMARKET_MAX_ORDER_USD || cfg.maxOrderUsd || 10
);
const dry =
  args.dry === "true" || args.dry === "1" || args.help === "true" || args.help === "1";

if (args.help === "true" || args.help === "1") {
  console.log(
    JSON.stringify(
      {
        ok: true,
        help: true,
        usage:
          "node place_order.mjs --slug btc-updown-5m-<ts> --outcome up|down --side BUY|SELL --amount <usd> [--shares N|--price P] [--dry]",
        caps: { POLYMARKET_MAX_ORDER_USD: MAX },
        flags: ["slug", "outcome", "side", "amount", "dry", "help"],
        path: "clob-client explicit POLY_PROXY",
      },
      null,
      2
    )
  );
  process.exit(0);
}

const amount = Number(args.amount || "1");
if (!(amount > 0) || amount > MAX) {
  console.error(
    JSON.stringify({
      ok: false,
      error: "amount_cap",
      amount,
      max: MAX,
      message: `amount must be in (0, ${MAX}]`,
    })
  );
  process.exit(1);
}

const sideStr = (args.side || "BUY").toUpperCase();
const side = sideStr === "SELL" ? Side.SELL : Side.BUY;
const outcome = (args.outcome || "").toLowerCase();
const names = outcome ? outcomeNames(outcome) : null;

if (outcome && !names) {
  console.error(
    JSON.stringify({
      ok: false,
      error: "bad_outcome",
      outcome,
      message: "outcome must be up|down (or yes|no)",
    })
  );
  process.exit(1);
}

try {
  const built = await buildClobClient(cfg);
  const diag = {
    signer: maskAddr(await built.signer.getAddress()),
    funder: maskAddr(built.funder),
    signatureType: built.signatureType,
    signatureTypeName: built.signatureTypeName,
    walletType: built.walletType,
    signerType: built.signerType,
    path: "clob-client-explicit",
  };

  if (built.signatureType !== 1) {
    console.error(
      JSON.stringify({
        ok: false,
        error: "bad_signature_type",
        message: "expected signatureType=1 (POLY_PROXY)",
        ...diag,
      })
    );
    process.exit(1);
  }

  const pub = createPublicClient();
  let market;
  if (args.slug) market = await pub.fetchMarket({ slug: args.slug });
  else
    market = (await pub.listMarkets({ closed: false, pageSize: 10 }).firstPage())
      .items[0];

  let assetId;
  if (names) {
    assetId = assetIdForOutcome(market, names);
    if (!assetId) {
      console.log(
        JSON.stringify(
          {
            ok: false,
            error: "missing_asset_id",
            slug: market?.slug,
            outcome,
            outcomeKeys: Object.keys(market?.outcomes || {}),
            ...diag,
          },
          null,
          2
        )
      );
      process.exit(1);
    }
  } else {
    const yes = market.outcomes.yes || market.outcomes.Up || market.outcomes.up;
    if (!yes) {
      assetId = assetIdForOutcome(market, ["Up", "yes"]);
    } else {
      assetId = market.version === "v2" ? yes.positionId : yes.tokenId;
    }
  }

  let shares = args.shares != null ? Number(args.shares) : null;
  const priceHint = args.price != null ? Number(args.price) : null;
  if (sideStr === "SELL") {
    if (!(shares > 0) && priceHint > 0 && amount > 0) {
      shares = Math.floor((amount / priceHint) * 10000) / 10000;
    }
    if (!(shares > 0)) {
      console.error(
        JSON.stringify({
          ok: false,
          error: "sell_needs_shares",
          message: "SELL requires --shares N (or --amount + --price to derive)",
          ...diag,
        })
      );
      process.exit(1);
    }
  }

  if (dry) {
    console.log(
      JSON.stringify(
        {
          ok: true,
          dry: true,
          market: market.slug,
          outcome: outcome || "default_yes",
          side: sideStr,
          amount: sideStr === "BUY" ? amount : undefined,
          shares: sideStr === "SELL" ? shares : undefined,
          max: MAX,
          assetId: String(assetId).slice(0, 12) + "…",
          outcomeKeys: Object.keys(market.outcomes || {}),
          action: "would_place",
          ...diag,
        },
        null,
        2
      )
    );
    process.exit(0);
  }

  const userMarketOrder =
    sideStr === "SELL"
      ? { tokenID: String(assetId), side, amount: Number(shares) }
      : { tokenID: String(assetId), side, amount: Number(amount) };

  const response = await built.client.createAndPostMarketOrder(
    userMarketOrder,
    undefined,
    OrderType.FOK
  );

  const ok =
    response &&
    (response.success === true ||
      response.status === "matched" ||
      response.orderID ||
      response.orderId ||
      response.id);

  console.log(
    JSON.stringify(
      {
        ok: Boolean(ok),
        market: market.slug,
        outcome: outcome || "default_yes",
        side: sideStr,
        amount: sideStr === "BUY" ? amount : undefined,
        shares: sideStr === "SELL" ? shares : undefined,
        signatureType: diag.signatureType,
        signatureTypeName: diag.signatureTypeName,
        walletType: diag.walletType,
        funder: diag.funder,
        signer: diag.signer,
        response,
      },
      null,
      2
    )
  );
  if (!ok) process.exit(1);
} catch (e) {
  console.error(JSON.stringify({ ok: false, error: String(e?.message || e) }));
  process.exit(1);
}
