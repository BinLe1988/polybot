#!/usr/bin/env node
/**
 * Limited live order helper.
 * Caps every order by POLYMARKET_MAX_ORDER_USD (env file or process.env).
 *
 * Paths (POLYMARKET_ORDER_PATH):
 *   auto    (default) — try explicit Poly Proxy (clob-client-v2, signatureType=1
 *            + funder from .env); on CLOB "maker address not allowed / deposit
 *            wallet flow" fall back once to deposit-wallet OWNER via
 *            @polymarket/client createSecureClient({signer, wallet:deposit}).
 *   proxy   — only explicit Poly Proxy (clob-client-v2).
 *   deposit — only deposit-wallet OWNER flow (unified client).
 *
 * CLOB production requires V2-signed orders (EIP-712 domain version "2").
 * Legacy @polymarket/clob-client (v1) yields HTTP 400:
 *   "invalid order version, please use the latest clob-client"
 *
 * Do NOT pass the legacy Poly Proxy address into createSecureClient({wallet}):
 * that mislabels the account as DEPOSIT_WALLET + SESSION_KEY and yields
 * "order signer address has to be the address of the API KEY".
 *
 * Usage:
 *   node place_order.mjs --slug btc-updown-5m-<ts> --outcome up|down --side BUY|SELL --amount 2
 *   node place_order.mjs --slug ... --outcome down --side BUY --amount 2 --dry
 *   node place_order.mjs --slug ... --outcome up --side BUY --amount 2 --sign-only
 *
 * Exit 0 only if response.ok (or --dry / --sign-only succeeded). Prints JSON.
 * Never prints private keys or API secrets.
 */
import { ClobClient, OrderType, Side, Chain } from "@polymarket/clob-client-v2";
import { Wallet } from "@ethersproject/wallet";
import {
  createPublicClient,
  createSecureClient,
  OrderSide,
} from "@polymarket/client";
import { loadEnv, parseArgs } from "./lib_env.mjs";

const SIG_NAMES = {
  0: "EOA",
  1: "POLY_PROXY",
  2: "POLY_GNOSIS_SAFE",
  3: "POLY_1271",
};

function maskAddr(a) {
  const s = String(a || "");
  if (s.length < 10) return s ? "***" : "";
  return `${s.slice(0, 6)}…${s.slice(-4)}`;
}

function assetIdForOutcome(market, names) {
  const entries = Object.entries(market.outcomes || {});
  for (const want of names) {
    for (const [k, v] of entries) {
      if (String(k).toLowerCase() === want.toLowerCase()) {
        return market.version === "v2" ? v.positionId : v.tokenId;
      }
    }
  }
  for (const [, v] of entries) {
    const n = String(v?.name || v?.label || "").toLowerCase();
    if (names.some((w) => n === w.toLowerCase())) {
      return market.version === "v2" ? v.positionId : v.tokenId;
    }
  }
  return null;
}

function outcomeNames(outcome) {
  const o = String(outcome || "").toLowerCase();
  if (o === "up" || o === "yes") return ["Up", "yes", "UP", "Yes"];
  if (o === "down" || o === "no") return ["Down", "no", "DOWN", "No"];
  return null;
}

function resolveSignatureType(raw) {
  if (raw == null || raw === "") return 1;
  const s = String(raw).trim().toUpperCase();
  if (s === "POLY_PROXY" || s === "PROXY") return 1;
  if (s === "EOA") return 0;
  if (s === "POLY_GNOSIS_SAFE" || s === "GNOSIS_SAFE" || s === "SAFE") return 2;
  if (s === "POLY_1271" || s === "1271") return 3;
  const n = Number(s);
  return Number.isFinite(n) ? n : 1;
}

function resolveOrderPath(raw) {
  const s = String(raw || process.env.POLYMARKET_ORDER_PATH || "auto")
    .trim()
    .toLowerCase();
  if (s === "proxy" || s === "poly_proxy" || s === "v2-proxy") return "proxy";
  if (s === "deposit" || s === "deposit_wallet" || s === "1271") return "deposit";
  return "auto";
}

function orderAsset(market, assetId) {
  const id = String(assetId);
  if (market?.version === "v2") return { positionID: id };
  return { tokenID: id };
}

function summarizeSigned(order) {
  if (!order || typeof order !== "object") return { present: false };
  const keys = Object.keys(order);
  return {
    present: true,
    keys,
    hasTimestamp: "timestamp" in order || "timestamp" in (order.order || {}),
    hasMetadata: "metadata" in order || "metadata" in (order.order || {}),
    hasBuilder: "builder" in order || "builder" in (order.order || {}),
    hasNonce: "nonce" in order || "nonce" in (order.order || {}),
    hasFeeRateBps: "feeRateBps" in order || "feeRateBps" in (order.order || {}),
    signatureType: order.signatureType ?? order.order?.signatureType,
    signaturePrefix:
      String(order.signature || order.order?.signature || "").slice(0, 10) ||
      undefined,
  };
}

function looksV2Signed(summary) {
  return (
    summary.hasTimestamp &&
    summary.hasMetadata &&
    summary.hasBuilder &&
    !summary.hasNonce &&
    !summary.hasFeeRateBps
  );
}

function stripTypes(types) {
  const o = { ...(types || {}) };
  delete o.EIP712Domain;
  return o;
}

function ethersSignerAdapter(wallet) {
  return {
    async getAddress() {
      return wallet.getAddress();
    },
    async signTypedData(...args) {
      if (args.length === 1 && args[0]?.domain) {
        const p = args[0];
        return wallet._signTypedData(
          p.domain,
          stripTypes(p.types || {}),
          p.message ?? p.value
        );
      }
      const [domain, types, value] = args;
      return wallet._signTypedData(domain, stripTypes(types || {}), value);
    },
    async signMessage(msg) {
      return wallet.signMessage(
        typeof msg === "string" ? msg : msg?.raw ?? msg
      );
    },
  };
}

function isMakerDepositReject(errText) {
  const t = String(errText || "").toLowerCase();
  return (
    t.includes("maker address not allowed") ||
    t.includes("deposit wallet flow")
  );
}

function normalizeErrText(response, caught) {
  if (caught) return String(caught?.message || caught);
  if (!response) return "";
  if (typeof response === "string") return response;
  return String(
    response.error ||
      response.errorMsg ||
      response.message ||
      response.body ||
      JSON.stringify(response)
  );
}

function responseOk(response, errText) {
  const versionReject =
    /invalid order version|order version/i.test(errText || "");
  if (!response || versionReject) return { ok: false, versionReject };
  const ok =
    response.success === true ||
    response.ok === true ||
    response.status === "matched" ||
    response.status === "live" ||
    response.status === "Live" ||
    Boolean(response.orderID || response.orderId || response.id);
  return { ok: Boolean(ok), versionReject: false };
}

async function buildProxyClient(cfg) {
  const host = "https://clob.polymarket.com";
  const chain = Chain.POLYGON;
  const signatureType = resolveSignatureType(
    process.env.POLYMARKET_SIGNATURE_TYPE ?? cfg.signatureType
  );
  const funderAddress =
    process.env.POLYMARKET_FUNDER_ADDRESS ||
    process.env.POLYMARKET_WALLET_ADDRESS ||
    cfg.funder ||
    cfg.wallet;
  const signer = new Wallet(cfg.privateKey);

  const creds = await new ClobClient({
    host,
    chain,
    signer,
  }).createOrDeriveApiKey();

  const client = new ClobClient({
    host,
    chain,
    signer,
    creds,
    signatureType,
    funderAddress,
  });

  let orderVersion = null;
  try {
    orderVersion = await client.getVersion();
  } catch (_) {
    orderVersion = null;
  }

  const st =
    client.signatureType ?? client.orderBuilder?.signatureType ?? signatureType;
  return {
    kind: "proxy",
    client,
    signer,
    funder: funderAddress,
    signatureType: st,
    signatureTypeName: SIG_NAMES[st] || String(st),
    walletType:
      SIG_NAMES[st] === "POLY_PROXY" ? "POLY_PROXY" : SIG_NAMES[st] || "UNKNOWN",
    signerType: "OWNER",
    orderVersion,
    clientPackage: "@polymarket/clob-client-v2",
    path: "clob-client-v2-explicit",
  };
}

async function buildDepositClient(cfg) {
  const wallet = new Wallet(cfg.privateKey);
  const signer = ethersSignerAdapter(wallet);

  // Resolve the CREATE2 deposit wallet first (never pass legacy Poly Proxy).
  const probe = await createSecureClient({ signer });
  const depositWallet = probe.account?.wallet;
  if (!depositWallet) {
    throw new Error("deposit_wallet_unresolved");
  }
  // Re-bind with explicit deposit address → OWNER + DEPOSIT_WALLET.
  const client = await createSecureClient({
    signer,
    wallet: depositWallet,
  });
  const acct = client.account || {};
  if (acct.signerType && acct.signerType !== "OWNER") {
    throw new Error(
      `deposit_signerType_unexpected:${acct.signerType} (refusing SESSION_KEY path)`
    );
  }
  return {
    kind: "deposit",
    client,
    signer: wallet,
    funder: acct.wallet || depositWallet,
    signatureType: 3,
    signatureTypeName: "POLY_1271",
    walletType: "DEPOSIT_WALLET",
    signerType: acct.signerType || "OWNER",
    orderVersion: 2,
    clientPackage: "@polymarket/client",
    path: "secure-client-deposit-owner",
  };
}

function diagFrom(built) {
  return {
    signer: null, // filled async
    funder: maskAddr(built.funder),
    signatureType: built.signatureType,
    signatureTypeName: built.signatureTypeName,
    walletType: built.walletType,
    signerType: built.signerType,
    path: built.path,
    clientPackage: built.clientPackage,
    orderVersion: built.orderVersion,
  };
}

async function placeViaProxy(built, market, assetId, sideStr, amount, shares) {
  const asset = orderAsset(market, assetId);
  const userMarketOrder =
    sideStr === "SELL"
      ? { ...asset, side: Side.SELL, amount: Number(shares), orderType: OrderType.FOK }
      : { ...asset, side: Side.BUY, amount: Number(amount), orderType: OrderType.FOK };
  const response = await built.client.createAndPostMarketOrder(
    userMarketOrder,
    undefined,
    OrderType.FOK
  );
  return { response, caught: null };
}

async function signViaProxy(built, market, assetId, sideStr, amount, shares) {
  const asset = orderAsset(market, assetId);
  const userMarketOrder =
    sideStr === "SELL"
      ? { ...asset, side: Side.SELL, amount: Number(shares), orderType: OrderType.FOK }
      : { ...asset, side: Side.BUY, amount: Number(amount), orderType: OrderType.FOK };
  return built.client.createMarketOrder(userMarketOrder);
}

async function placeViaDeposit(built, assetId, sideStr, amount, shares) {
  const body =
    sideStr === "SELL"
      ? {
          assetId: String(assetId),
          side: OrderSide.SELL,
          shares: Number(shares),
          orderType: "FOK",
        }
      : {
          assetId: String(assetId),
          side: OrderSide.BUY,
          amount: Number(amount),
          orderType: "FOK",
        };
  try {
    const response = await built.client.placeMarketOrder(body);
    return { response, caught: null };
  } catch (e) {
    return { response: null, caught: e };
  }
}

async function signViaDeposit(built, assetId, sideStr, amount, shares) {
  const body =
    sideStr === "SELL"
      ? {
          assetId: String(assetId),
          side: OrderSide.SELL,
          shares: Number(shares),
          orderType: "FOK",
        }
      : {
          assetId: String(assetId),
          side: OrderSide.BUY,
          amount: Number(amount),
          orderType: "FOK",
        };
  return built.client.createMarketOrder(body);
}

const args = parseArgs();
const cfg = loadEnv();
const MAX = Number(
  process.env.POLYMARKET_MAX_ORDER_USD || cfg.maxOrderUsd || 10
);
const dry =
  args.dry === "true" || args.dry === "1" || args.help === "true" || args.help === "1";
const signOnly = args["sign-only"] === "true" || args["sign-only"] === "1";
const orderPath = resolveOrderPath(args.path);

if (args.help === "true" || args.help === "1") {
  console.log(
    JSON.stringify(
      {
        ok: true,
        help: true,
        usage:
          "node place_order.mjs --slug btc-updown-5m-<ts> --outcome up|down --side BUY|SELL --amount <usd> [--shares N|--price P] [--dry|--sign-only] [--path auto|proxy|deposit]",
        caps: { POLYMARKET_MAX_ORDER_USD: MAX },
        flags: ["slug", "outcome", "side", "amount", "dry", "sign-only", "path", "help"],
        orderPathDefault: "auto",
      },
      null,
      2
    )
  );
  process.exit(0);
}

const amount = Number(args.amount || "1");
if (!(amount > 0) || amount > MAX) {
  console.error(
    JSON.stringify({
      ok: false,
      error: "amount_cap",
      amount,
      max: MAX,
      message: `amount must be in (0, ${MAX}]`,
    })
  );
  process.exit(1);
}

const sideStr = (args.side || "BUY").toUpperCase();
const outcome = (args.outcome || "").toLowerCase();
const names = outcome ? outcomeNames(outcome) : null;

if (outcome && !names) {
  console.error(
    JSON.stringify({
      ok: false,
      error: "bad_outcome",
      outcome,
      message: "outcome must be up|down (or yes|no)",
    })
  );
  process.exit(1);
}

try {
  const preferDeposit = orderPath === "deposit";
  const preferProxy = orderPath === "proxy" || orderPath === "auto";

  let built;
  if (preferDeposit) {
    built = await buildDepositClient(cfg);
  } else {
    built = await buildProxyClient(cfg);
    if (built.signatureType !== 1 && orderPath === "proxy") {
      console.error(
        JSON.stringify({
          ok: false,
          error: "bad_signature_type",
          message: "proxy path expects signatureType=1 (POLY_PROXY)",
          signatureType: built.signatureType,
          signatureTypeName: built.signatureTypeName,
        })
      );
      process.exit(1);
    }
  }

  const diag = diagFrom(built);
  diag.signer = maskAddr(await built.signer.getAddress());
  diag.orderPath = orderPath;

  const pub = createPublicClient();
  let market;
  if (args.slug) market = await pub.fetchMarket({ slug: args.slug });
  else
    market = (await pub.listMarkets({ closed: false, pageSize: 10 }).firstPage())
      .items[0];

  let assetId;
  if (names) {
    assetId = assetIdForOutcome(market, names);
    if (!assetId) {
      console.log(
        JSON.stringify(
          {
            ok: false,
            error: "missing_asset_id",
            slug: market?.slug,
            outcome,
            outcomeKeys: Object.keys(market?.outcomes || {}),
            ...diag,
          },
          null,
          2
        )
      );
      process.exit(1);
    }
  } else {
    const yes = market.outcomes.yes || market.outcomes.Up || market.outcomes.up;
    if (!yes) {
      assetId = assetIdForOutcome(market, ["Up", "yes"]);
    } else {
      assetId = market.version === "v2" ? yes.positionId : yes.tokenId;
    }
  }

  let shares = args.shares != null ? Number(args.shares) : null;
  const priceHint = args.price != null ? Number(args.price) : null;
  if (sideStr === "SELL") {
    if (!(shares > 0) && priceHint > 0 && amount > 0) {
      shares = Math.floor((amount / priceHint) * 10000) / 10000;
    }
    if (!(shares > 0)) {
      console.error(
        JSON.stringify({
          ok: false,
          error: "sell_needs_shares",
          message: "SELL requires --shares N (or --amount + --price to derive)",
          ...diag,
        })
      );
      process.exit(1);
    }
  }

  if (dry) {
    console.log(
      JSON.stringify(
        {
          ok: true,
          dry: true,
          market: market.slug,
          marketVersion: market.version,
          outcome: outcome || "default_yes",
          side: sideStr,
          amount: sideStr === "BUY" ? amount : undefined,
          shares: sideStr === "SELL" ? shares : undefined,
          max: MAX,
          assetId: String(assetId).slice(0, 12) + "…",
          outcomeKeys: Object.keys(market.outcomes || {}),
          action: "would_place",
          ...diag,
        },
        null,
        2
      )
    );
    process.exit(0);
  }

  if (signOnly) {
    const signed =
      built.kind === "deposit"
        ? await signViaDeposit(built, assetId, sideStr, amount, shares)
        : await signViaProxy(built, market, assetId, sideStr, amount, shares);
    const summary = summarizeSigned(signed);
    const v2 = looksV2Signed(summary);
    console.log(
      JSON.stringify(
        {
          ok: v2,
          signOnly: true,
          market: market.slug,
          marketVersion: market.version,
          outcome: outcome || "default_yes",
          side: sideStr,
          amount: sideStr === "BUY" ? amount : undefined,
          shares: sideStr === "SELL" ? shares : undefined,
          signedOrder: summary,
          looksV2: v2,
          ...diag,
        },
        null,
        2
      )
    );
    process.exit(v2 ? 0 : 1);
  }

  // Live place
  let used = built;
  let { response, caught } = preferProxy
    ? await placeViaProxy(built, market, assetId, sideStr, amount, shares).catch(
        (e) => ({ response: null, caught: e })
      )
    : await placeViaDeposit(built, assetId, sideStr, amount, shares);

  let errText = normalizeErrText(response, caught);
  let fallbackUsed = false;

  if (
    orderPath === "auto" &&
    used.kind === "proxy" &&
    isMakerDepositReject(errText)
  ) {
    const dep = await buildDepositClient(cfg);
    used = dep;
    fallbackUsed = true;
    ({ response, caught } = await placeViaDeposit(
      dep,
      assetId,
      sideStr,
      amount,
      shares
    ));
    errText = normalizeErrText(response, caught);
  }

  const finalDiag = {
    ...diagFrom(used),
    signer: maskAddr(await used.signer.getAddress()),
    orderPath,
    fallbackUsed,
    proxyRejectedMaker: fallbackUsed,
  };
  const { ok, versionReject } = responseOk(response, errText);

  // Surface caught errors (e.g. balance) in response shape for DAXUE logs
  const outResponse =
    response ||
    (caught
      ? {
          error: String(caught.message || caught),
          status: /https?:\/\//.test(String(caught.message || ""))
            ? 400
            : undefined,
        }
      : null);

  console.log(
    JSON.stringify(
      {
        ok: Boolean(ok),
        market: market.slug,
        outcome: outcome || "default_yes",
        side: sideStr,
        amount: sideStr === "BUY" ? amount : undefined,
        shares: sideStr === "SELL" ? shares : undefined,
        signatureType: finalDiag.signatureType,
        signatureTypeName: finalDiag.signatureTypeName,
        walletType: finalDiag.walletType,
        funder: finalDiag.funder,
        signer: finalDiag.signer,
        path: finalDiag.path,
        clientPackage: finalDiag.clientPackage,
        orderVersion: finalDiag.orderVersion,
        orderPath: finalDiag.orderPath,
        fallbackUsed: finalDiag.fallbackUsed,
        versionReject,
        makerDepositReject: isMakerDepositReject(errText),
        response: outResponse,
      },
      null,
      2
    )
  );
  if (!ok) process.exit(1);
} catch (e) {
  const msg = String(e?.message || e);
  console.error(
    JSON.stringify({
      ok: false,
      error: msg,
      versionReject: /invalid order version/i.test(msg),
      makerDepositReject: isMakerDepositReject(msg),
    })
  );
  process.exit(1);
}
